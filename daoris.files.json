{
  "form": 2,
  "_why": "How Daoris's trees handle this repository's files git does not manage (docs/2026-10-26-tree-pool-design.md §29, §35.1). Each entry's paths are git's ignore patterns, read in order, a later entry winning; this machine's own rules come after these.",
  "rules": [
    { "kind": "local", "paths": ["/local/"] },
    { "kind": "local", "paths": ["/local/lyntai-local.props", "!/local/lyntai-local.props/"], "reach": "copy" },
    { "kind": "local", "paths": ["/local/shenora-local.props", "!/local/shenora-local.props/"], "reach": "copy" },
    { "kind": "scratch", "paths": ["/_fixtures/", "/**/_fixtures/"] },
    { "kind": "dependency", "paths": ["/src/Daoris.Web/node_modules/"],
      "key": ["src/Daoris.Web/package-lock.json", "src/Daoris.Web/package.json", "src/Daoris.Web/.npmrc"],
      "caches": [".cache/", ".vite/", ".vite-temp/"] },
    { "kind": "dependency", "paths": ["/node_modules/"],
      "key": ["package-lock.json", "package.json", "src/Daoris.Cli/package.json", ".npmrc"],
      "setup": ["node tools/merge-rows.mjs --install", "node tools/index-hook.mjs --install"], "per": "repository" },
    { "kind": "intermediate", "paths": ["/src/**/obj/", "/tools/**/obj/"], "toolchain": ["dotnet --version"] },
    { "kind": "output", "paths": ["bin/"], "take": "base",
      "refuses": ["node tools/desktop.mjs run", "node tools/desktop.mjs restart", "node tools/proof-kit.mjs", "node tools/family-rehearsal.mjs",
        "node src/Daoris.Web/scripts/e2e-host.mjs"] },
    { "kind": "output", "paths": ["/tools/*/bin/"], "take": "aside" },
    { "kind": "output", "paths": ["/src/Daoris.Service/Daoris.Service.Http/wwwroot/", "/src/Daoris.Cli/dist/", "/docs/index/",
      "/src/Daoris.Web/src/data/generated/", "/src/Daoris.Web/src/bridge/generated/"] }
  ]
}
