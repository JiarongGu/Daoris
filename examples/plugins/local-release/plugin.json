{
  "id": "local-release",
  "apiVersion": 1,
  "name": "Local release",
  "version": "0.1.0",
  "description": "An example of publish and release as a plugin's performed steps: it finds a pending release for the attempt's revision, records the release, and copies the built package into a registry folder, all inside its own data folder. It never pushes.",
  "hooks": {
    "command": ["node", "${plugin}/plugin.mjs"],
    "points": ["work/watch", "work/step", "work/perform"]
  },
  "steps": [
    {
      "id": "find",
      "reach": "performed",
      "outputs": { "release": "local-release/release@1" },
      "evidence": { "schema": "local-release/receipt@1" },
      "perform": { "point": "work/perform", "idempotent": true, "reconcile": "work/reconcile", "transient": ["unavailable", "rate-limited", "timeout"] },
      "retry": { "maxAttempts": 3, "delaysSeconds": [5, 30] },
      "timeoutSeconds": 600
    },
    {
      "id": "release",
      "reach": "performed",
      "inputs": { "release": "local-release/release@1" },
      "outputs": { "release": "local-release/release@1" },
      "evidence": { "schema": "local-release/receipt@1" },
      "perform": { "point": "work/perform", "idempotent": true, "reconcile": "work/reconcile", "transient": ["unavailable", "rate-limited", "timeout"] },
      "retry": { "maxAttempts": 3, "delaysSeconds": [5, 30] },
      "timeoutSeconds": 600
    },
    {
      "id": "publish",
      "reach": "performed",
      "inputs": { "release": "local-release/release@1" },
      "evidence": { "schema": "local-release/receipt@1" },
      "perform": { "point": "work/perform", "idempotent": true, "reconcile": "work/reconcile", "transient": ["unavailable", "rate-limited", "timeout"] },
      "retry": { "maxAttempts": 3, "delaysSeconds": [5, 30] },
      "timeoutSeconds": 600
    }
  ],
  "resources": [
    { "schema": "local-release/resource@1", "role": "temporary", "cleanup": "work/cleanup" }
  ],
  "tools": []
}
