<Project Sdk="Microsoft.NET.Sdk">

  <!-- Writes the page's types from the routes src/Daoris.Contracts declares and the window routes' marks in the desktop modules;
       run by tools/contracts.mjs, never shipped. It takes no package of its own: the modules bring theirs, from their tree's
       central versions. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CodePage>65001</CodePage>
    <IsPackable>false</IsPackable>
    <AssemblyName>contracts-gen</AssemblyName>
    <Description>writes the page's types for the service's routes and the window's routes</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Daoris.Contracts/Daoris.Contracts.csproj" />
    <ProjectReference Include="../../src/Daoris.Desktop/Daoris.Desktop.Modules/Daoris.Desktop.Modules.csproj" />
  </ItemGroup>

</Project>
