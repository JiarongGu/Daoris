<Project Sdk="Microsoft.NET.Sdk">

  <!-- CHR1's probe host (docs/2026-09-28-chromium-host-design.md §5): one WinForms window embedding
       Chromium through CefSharp, driven by tools/chromium-probe.mjs. Not shipped, not a gate. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>chromium-probe</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CefSharp.WinForms.NETCore" Version="152.0.100" />
  </ItemGroup>

</Project>
