<Project>

  <!--
    Build settings every .NET project of this repository builds with: found by a project with none of its own, imported by each
    tree's.

    The commit is stamped only where a publish or a stage builds. On the SDK's defaults the commit git reports goes into every
    assembly's informational version and source-link file, both inputs of its compile, so every switch between commits recompiled
    every project, the unchanged ones too. A development build reads no git and carries the fixed `+dev`; the publishes pass
    -p:DaorisStamp=true and carry `<version>+<commit>`, which an installed build, its stage's build.json and the rollback read.
  -->
  <PropertyGroup Condition="'$(DaorisStamp)' != 'true'">
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
    <SourceRevisionId>dev</SourceRevisionId>
  </PropertyGroup>

  <!--
    The one place the test budget is enforced in .NET: a test that runs past its bound ends the run, which says it hung. The owner's
    budget is seconds for a unit test and two minutes for a Process case; the bounds are ceilings over what passes today, and come
    down as the cases above them are cut (docs/2026-11-13-test-timing-census.md). A half that runs under a run-settings file is a
    Process half (`dotnet test` passes the file as VSTestSetting). No dump is written: the run's log names the test it ended on.
  -->
  <PropertyGroup>
    <VSTestBlameHang>true</VSTestBlameHang>
    <VSTestBlameHangDumpType>none</VSTestBlameHangDumpType>
    <VSTestBlameHangTimeout>1min</VSTestBlameHangTimeout>
  </PropertyGroup>
  <PropertyGroup Condition="'$(VSTestSetting)' != ''">
    <VSTestBlameHangTimeout>15min</VSTestBlameHangTimeout>
  </PropertyGroup>

</Project>
