<Project>

  <!--
    Build settings every .NET project of this repository builds with: found by a project with none of its own, imported by each
    tree's.

    The commit is stamped only where a publish or a stage builds. On the SDK's defaults the commit git reports goes into every
    assembly's informational version and source-link file, both inputs of its compile, so every switch between commits recompiled
    every project, the unchanged ones too. A development build reads no git and carries the fixed `+dev`; the publishes pass
    -p:DaorisStamp=true and carry `<version>+<commit>`, which an installed build, its stage's build.json and the rollback read.
  -->
  <PropertyGroup Condition="'$(DaorisStamp)' != 'true'">
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
    <SourceRevisionId>dev</SourceRevisionId>
  </PropertyGroup>

  <!--
    The one place the kill bound is set in .NET: a test that runs past it ends the run, which says it hung. The bound is 60 s for a unit
    half and five minutes for a Process half. The owner's budget is tighter (30 s for a unit test, two minutes for a Process case) and is
    held by tools/time-ratchet.mjs from the durations the gates record, so a legitimate slow test (a shared compile) is listed there
    rather than killing every run. A Process half's bound sits above the budget because a kill ends the whole half: a case of a few git
    starts took 133 s with the machine's cores held by other builds, and a bound at the budget turned that load into a crashed host. A half that runs under a run-settings
    file is a Process half (`dotnet test` passes the file as VSTestSetting). No dump is written: the run's log names the test it ended on.
  -->
  <PropertyGroup>
    <VSTestBlameHang>true</VSTestBlameHang>
    <VSTestBlameHangDumpType>none</VSTestBlameHangDumpType>
    <VSTestBlameHangTimeout>60s</VSTestBlameHangTimeout>
  </PropertyGroup>
  <PropertyGroup Condition="'$(VSTestSetting)' != ''">
    <VSTestBlameHangTimeout>5min</VSTestBlameHangTimeout>
  </PropertyGroup>

</Project>
