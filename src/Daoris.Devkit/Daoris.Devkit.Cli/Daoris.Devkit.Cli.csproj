<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Daoris.Devkit.Cli</RootNamespace>
    <AssemblyName>daoris-devkit</AssemblyName>
    <!-- The reason this artefact is a binary at all: one self-contained file, no runtime to install,
         and no Node dependency in a .NET repository that never wanted one. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The gates report findings, not exceptions; a stack trace here would be noise in a hook. -->
    <StackTraceSupport>false</StackTraceSupport>
    <!-- The AOT compiler package comes with the SDK's own runtime version, so its advisory (GHSA-p3jp-9v83-76w9) cannot be
         pinned away here; it stays a warning, and the binary runs gates on this repository, never untrusted input. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1903</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Daoris.Devkit.Core/Daoris.Devkit.Core.csproj" />
  </ItemGroup>
</Project>
