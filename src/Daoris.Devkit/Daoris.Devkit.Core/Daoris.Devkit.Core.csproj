<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Daoris.Devkit</RootNamespace>
    <!-- The whole tree is AOT-published through the CLI, so the library must stay AOT-clean too:
         no reflection-based serialization, no dynamic code. Warn at build rather than at publish. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <!-- The one fence reader: the service's, compiled in so the links gate reads a fence as every other reader does. -->
    <Compile Include="..\..\Daoris.Service\Daoris.Service.Core\Knowledge\Ingest\MarkdownFence.cs" Link="MarkdownFence.cs" />
  </ItemGroup>
</Project>
