<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The dependency tier of the desktop store's SQLite adapter: the contract cases the fake passes, run on the real engine over real
    files, and what only the file adds (the journal, the read-only open). It runs when the adapter's fingerprint differs from its row of
    daoris.adapters.lock, and never in a unit half.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CodePage>65001</CodePage>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RootNamespace>Daoris.Adapters.DesktopStore.Sqlite.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Daoris.Adapters.DesktopStore.Sqlite\Daoris.Adapters.DesktopStore.Sqlite.csproj" />
    <ProjectReference Include="..\..\Daoris.Testing\Daoris.Testing.csproj" />
  </ItemGroup>

</Project>
