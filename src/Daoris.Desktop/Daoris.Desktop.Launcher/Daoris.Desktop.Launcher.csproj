<Project Sdk="Microsoft.NET.Sdk">

  <!-- Daoris's launcher (D93): the one executable at an install's root, `Daoris.exe`, which starts the
       application from `app/`, where it sits beside its Chromium. Framework-dependent and single-file, so
       it is small, and it references nothing: a launcher that needed the application's libraries would
       be the application. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Daoris.Desktop.Launcher</RootNamespace>
    <AssemblyName>Daoris</AssemblyName>
    <ApplicationIcon>..\Daoris.Desktop.App\daoris.ico</ApplicationIcon>
    <Product>Daoris</Product>
    <AssemblyTitle>Daoris</AssemblyTitle>
    <Description>Daoris</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The update's check and swap (UPDATE1, D139 §5): the driver library's own source, compiled in rather than
         referenced, so the launcher still references nothing and the check it runs before it moves a file is the one the
         application runs before it closes. Two files of the Setup module (FLAT1b-iii-a): the records, names and their reads
         and writes on the disk, and the swap. Each uses the base library alone; `StagedBuildTests` holds them. -->
    <Compile Include="..\Daoris.Desktop.Driver\Setup\StagedBuild.cs" Link="StagedBuild.cs" />
    <Compile Include="..\Daoris.Desktop.Driver\Setup\InstallSwap.cs" Link="InstallSwap.cs" />
    <!-- What a move the swap was refused found held, and by which process (DEPLOYBUSY1). The base library and Windows'
         own calls alone. -->
    <Compile Include="..\Daoris.Desktop.Driver\Setup\HeldFiles.cs" Link="HeldFiles.cs" />
    <!-- The marks of a process's own writes (FABRIC-EVENT4): `StagedBuild` marks the journal it writes, so the updater's watch
         wakes nothing on it. It uses the base library alone. -->
    <Compile Include="..\Daoris.Desktop.Driver\Platform\HomeWrites.cs" Link="HomeWrites.cs" />
    <!-- The home's lease (HOMELEASE1, the terminal RPC design §5): the swap holds it while it replaces app/, so no verb the
         install carries acts alone from a folder being replaced. With the home's id, which a lease records, and the home's
         table, which names both their places (D172, HOMELAYOUT2), with the error its refusal is. Each uses the base library
         alone; `HomeLeaseTests` and `DaorisHomeTests` hold them. -->
    <Compile Include="..\Daoris.Desktop.Driver\Platform\HomeLease.cs" Link="HomeLease.cs" />
    <Compile Include="..\Daoris.Desktop.Driver\Platform\HomeIdentity.cs" Link="HomeIdentity.cs" />
    <Compile Include="..\Daoris.Desktop.Driver\Platform\DaorisHome.cs" Link="DaorisHome.cs" />
    <Compile Include="..\Daoris.Desktop.Driver\Platform\DriverException.cs" Link="DriverException.cs" />
    <!-- The shared read of a file moved into place (READSHARE1): the update request is read beside its writer, and the home's own files
         read through it. The base library alone. -->
    <Compile Include="..\Daoris.Desktop.Driver\Store\AtomicFile.cs" Link="AtomicFile.cs" />
    <Compile Include="..\Daoris.Desktop.Driver\Platform\BesideReads.cs" Link="BesideReads.cs" />
  </ItemGroup>

</Project>
