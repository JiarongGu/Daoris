<Project Sdk="Microsoft.NET.Sdk">

  <!-- Daoris's launcher (D93): the one executable at an install's root, `Daoris.exe`, which starts the
       application from `app/`, where it sits beside its Chromium. Framework-dependent and single-file, so
       it is small, and it references nothing: a launcher that needed the application's libraries would
       be the application. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Daoris.Desktop.Launcher</RootNamespace>
    <AssemblyName>Daoris</AssemblyName>
    <ApplicationIcon>..\Daoris.Desktop.App\daoris.ico</ApplicationIcon>
    <Product>Daoris</Product>
    <AssemblyTitle>Daoris</AssemblyTitle>
    <Description>Daoris</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The update's check and swap (UPDATE1, D139 §5): the driver library's own source, compiled in rather than
         referenced, so the launcher still references nothing and the check it runs before it moves a file is the one the
         application runs before it closes. The file uses the base library alone; `StagedBuildTests` holds it. -->
    <Compile Include="..\Daoris.Desktop.Driver\StagedBuild.cs" Link="StagedBuild.cs" />
  </ItemGroup>

</Project>
