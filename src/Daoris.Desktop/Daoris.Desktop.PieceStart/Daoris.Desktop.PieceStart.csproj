<Project Sdk="Microsoft.NET.Sdk">

  <!-- The launcher (COAGENT1b; D199's note on how a partner starts in its strict job; generalized by TERMTRUST1a, D201 point 4):
       `daoris-piece-start.exe`, laid out in the install's `app/bin/` beside the git doors, and started for every agent, plugin process
       and piece. It joins the named jobs it is handed (the Daoris process's agents' job, then a piece's), then a job of its own, then
       starts the harness as its child with the stdio it was handed, and refuses to start it where a job cannot be joined. A console
       program, since the doors read the harness's protocol over its standard streams. Framework-dependent and referencing nothing, as
       the git doors are: the driver library's own files are compiled in, each using the base library alone. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Daoris.Desktop.PieceStart</RootNamespace>
    <AssemblyName>daoris-piece-start</AssemblyName>
    <Product>Daoris</Product>
    <Description>Daoris's agents' launcher: joins this Daoris's agents' job and any piece's, then starts the harness inside them</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <!-- The launcher's words, its join and its start (COAGENT1b): `PieceLauncherTests` holds them. -->
    <Compile Include="..\Daoris.Desktop.Driver\Platform\PieceLauncher.cs" Link="PieceLauncher.cs" />
    <Compile Include="..\Daoris.Desktop.Driver\Platform\ProcessJob.cs" Link="ProcessJob.cs" />
  </ItemGroup>

</Project>
