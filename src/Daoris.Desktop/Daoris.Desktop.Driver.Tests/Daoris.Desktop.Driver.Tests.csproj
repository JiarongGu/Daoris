<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Read by StructureCheck alone (FOUNDATION1 mod-0): one compilation of the driver's sources, so each name binds to a symbol. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- The stand-in SSH host of the doors' process tests (GitSshHost): a loopback server in the test process, nothing installed. -->
    <PackageReference Include="Microsoft.DevTunnels.Ssh.Tcp" />
    <!-- The banned-name analyzer as files alone, which DeclarationAnalyzerTests loads over a test's compilation: it never runs on this
         project's own build, whose tests name the store's members. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <None Include="$(PkgMicrosoft_CodeAnalysis_BannedApiAnalyzers)/analyzers/dotnet/cs/*.dll" Link="BannedApi/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Daoris.Desktop.Driver\Daoris.Desktop.Driver.csproj" />
    <!-- The fakes and the virtual clock the unit tiers share. -->
    <ProjectReference Include="..\..\Daoris.Testing\Daoris.Testing.csproj" />
    <!-- The machine's liveness the test root answers real processes by, until the Process classes leave the unit tier. -->
    <Compile Include="..\..\Daoris.Adapters\Daoris.Adapters.Machine\ProcessLiveness.cs" Link="Bridge\ProcessLiveness.cs" />
    <!-- The git adapter over the machine's host, which the classes that still run real git here hand their roots, until the Process
         classes leave the unit tier for the rehearsal tier, which references the adapters whole. -->
    <Compile Include="..\..\Daoris.Adapters\Daoris.Adapters.Machine\MachineProcessHost.cs" Link="Bridge\MachineProcessHost.cs" />
    <Compile Include="..\..\Daoris.Adapters\Daoris.Adapters.Machine\MachineRun.cs" Link="Bridge\MachineRun.cs" />
    <Compile Include="..\..\Daoris.Adapters\Daoris.Adapters.Machine\ProcessOwner.cs" Link="Bridge\ProcessOwner.cs" />
    <Compile Include="..\..\Daoris.Adapters\Daoris.Adapters.Git\GitProcessRuns.cs" Link="Bridge\GitProcessRuns.cs" />
    <Using Include="Daoris.Ports.Browser" />
    <Using Include="Daoris.Ports.Clocks" />
    <Using Include="Daoris.Ports.Git.GitWait" Alias="GitWait" />
    <!-- Built first and never referenced (DRV8a): its tests start `daoris-driver` itself, to hold that a
         bare invocation starts nothing and a held home is refused before the service is reached. -->
    <ProjectReference Include="..\Daoris.Desktop.Driver.Host\Daoris.Desktop.Driver.Host.csproj" ReferenceOutputAssembly="false" />
    <!-- Built first and never referenced (LAUNCHGATE1): the launcher compiles driver files in by link and references nothing,
         so a driver change it cannot compile (a type the base library lacks) surfaced only in the publish. The driver gate
         builds it here, a compile of six files. -->
    <ProjectReference Include="..\Daoris.Desktop.Launcher\Daoris.Desktop.Launcher.csproj" ReferenceOutputAssembly="false" />
    <!-- Built first and never referenced (GITAUTH1b): the git doors compile driver files in by link, and `GitDoorsProcessTests`
         lays the built program out as an install's doors and has git start it. -->
    <ProjectReference Include="..\Daoris.Desktop.GitDoor\Daoris.Desktop.GitDoor.csproj" ReferenceOutputAssembly="false" />
    <!-- Built first and never referenced (COAGENT1b): the partner's launcher compiles driver files in by link, and
         `PieceLauncherProcessTests` starts the built program in a piece's job. -->
    <ProjectReference Include="..\Daoris.Desktop.PieceStart\Daoris.Desktop.PieceStart.csproj" ReferenceOutputAssembly="false" />
    <!-- Built first and never referenced: the install's command compiles one driver file in by link, and
         `CommandLauncherProcessTests` starts the built program with words of several lines. -->
    <ProjectReference Include="..\Daoris.Desktop.Command\Daoris.Desktop.Command.csproj" ReferenceOutputAssembly="false" />
    <!-- Built first and never referenced (D249): a test's owner, compiling the one management in by link, which
         `OwnedProcessesProcessTests` kills to find what it started gone with it. -->
    <ProjectReference Include="..\Daoris.Desktop.OwnerStandIn\Daoris.Desktop.OwnerStandIn.csproj" ReferenceOutputAssembly="false" />
    <!-- The service's HTTP host is not referenced (KEEPSIZE1b3): the merge tool runs gates of two components beside each other, and two
         builds of one project fight over its obj folder. `RealServiceHost` builds its own copy on first use, under this project's obj. -->
  </ItemGroup>

  <!-- The agent layer's adapter compiles only where Lyntai's local build is in use (D248), and so do its tests. -->
  <ItemGroup Condition="'$(DaorisLyntaiLayer)' != 'true'">
    <Compile Remove="Agents\Layer\**" />
  </ItemGroup>

</Project>
