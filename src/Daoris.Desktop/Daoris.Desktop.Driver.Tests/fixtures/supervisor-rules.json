{
  "about": "CONTEXTDRIVE1c (the context counters design §4.1, §4.4, §4.5): supervisor rules, judged and made effective for a line. A rule here omits `place` and `window` unless the case tests them: the set's place and the count's own window fill them. `rules: \"base\"` is the machine's seed, tries at 5 held. The catalogue holds build, chat and helper.",
  "roles": ["build", "chat", "helper"],
  "base": [
    { "id": "m-aa", "count": "answers-alone", "at": 2, "do": "hold" },
    { "id": "m-f", "count": "failures", "at": 3, "do": "hold" },
    { "id": "m-t", "count": "tries", "at": 5, "do": "hold" },
    { "id": "m-mv", "count": "moves", "at": 3, "do": "ask" }
  ],
  "judge": [
    { "name": "a repository's rule beside the machine's seed stands",
      "place": "repository:daoris", "revision": 0, "rules": [{ "id": "r-1", "count": "quiet", "at": 1, "do": "weighted" }], "expect": null },
    { "name": "an empty first write of a place stands",
      "place": "workspace:w1", "revision": 0, "rules": [], "expect": null },
    { "name": "an unknown count", "place": "machine", "revision": 1, "rules": [{ "id": "x", "count": "tokens", "at": 1, "do": "hold" }], "expect": "count" },
    { "name": "a window the count does not offer", "place": "machine", "revision": 1,
      "rules": [{ "id": "x", "count": "failures", "window": "episode", "at": 3, "do": "hold" }], "expect": "window" },
    { "name": "tries past 5", "place": "machine", "revision": 1, "rules": [{ "id": "x", "count": "tries", "at": 6, "do": "hold" }], "expect": "at" },
    { "name": "answers-alone at 0", "place": "machine", "revision": 1, "rules": [{ "id": "x", "count": "answers-alone", "at": 0, "do": "hold" }], "expect": "at" },
    { "name": "quiet at 2", "place": "repository:daoris", "revision": 0, "rules": [{ "id": "x", "count": "quiet", "at": 2, "do": "next" }], "expect": "at" },
    { "name": "failures-on-choice not below the failures rule it is under",
      "place": "repository:daoris", "revision": 0, "rules": [{ "id": "x", "count": "failures-on-choice", "at": 3, "do": "next" }], "expect": "at" },
    { "name": "failures-on-choice below the failures rule stands",
      "place": "repository:daoris", "revision": 0, "rules": [{ "id": "x", "count": "failures-on-choice", "at": 2, "do": "next" }], "expect": null },
    { "name": "an action the count does not allow", "place": "machine", "revision": 1, "rules": [{ "id": "x", "count": "answers-alone", "at": 2, "do": "ask" }], "expect": "do" },
    { "name": "off on tries", "place": "machine", "revision": 1, "rules": [{ "id": "x", "count": "tries", "at": 1, "do": "off" }], "expect": "do" },
    { "name": "off beside another rule on its count and roles",
      "place": "repository:daoris", "revision": 0,
      "rules": [{ "id": "a", "count": "answers-alone", "at": 1, "do": "off" }, { "id": "b", "count": "answers-alone", "at": 3, "do": "hold" }], "expect": "ladder" },
    { "name": "two rules on one count at one at for overlapping roles are a ladder",
      "place": "machine", "revision": 1,
      "rules": [{ "id": "m-t", "count": "tries", "at": 5, "do": "hold" }, { "id": "m-mv", "count": "moves", "at": 3, "do": "ask" },
        { "id": "a", "count": "limits", "at": 1, "do": "weighted", "roles": ["build"] }, { "id": "b", "count": "limits", "at": 1, "do": "wait", "upTo": 30, "roles": ["build", "chat"] }],
      "expect": "ladder" },
    { "name": "a ladder of tries for every role is refused",
      "place": "machine", "revision": 1,
      "rules": [{ "id": "a", "count": "tries", "at": 2, "do": "weighted" }, { "id": "b", "count": "tries", "at": 5, "do": "hold" }, { "id": "m-mv", "count": "moves", "at": 3, "do": "ask" }],
      "expect": "ladder" },
    { "name": "a rule for a role beside the every-role rule on its count stands",
      "place": "repository:daoris", "revision": 0,
      "rules": [{ "id": "a", "count": "answers-alone", "at": 4, "do": "hold", "roles": ["build"] }, { "id": "b", "count": "answers-alone", "at": 3, "do": "hold" }],
      "expect": null },
    { "name": "wait without upTo", "place": "repository:daoris", "revision": 0, "rules": [{ "id": "x", "count": "limits", "at": 1, "do": "wait" }], "expect": "upTo" },
    { "name": "wait upTo under 5", "place": "repository:daoris", "revision": 0, "rules": [{ "id": "x", "count": "limits", "at": 1, "do": "wait", "upTo": 4 }], "expect": "upTo" },
    { "name": "wait upTo 600 stands", "place": "repository:daoris", "revision": 0, "rules": [{ "id": "x", "count": "limits", "at": 1, "do": "wait", "upTo": 600 }], "expect": null },
    { "name": "upTo on a hold", "place": "machine", "revision": 1,
      "rules": [{ "id": "x", "count": "tries", "at": 5, "do": "hold", "upTo": 10 }], "expect": "upTo" },
    { "name": "a rule naming another place", "place": "repository:daoris", "revision": 0,
      "rules": [{ "id": "x", "count": "quiet", "at": 1, "do": "next", "place": "repository:other" }], "expect": "place" },
    { "name": "a place of no kind Daoris drives", "place": "planet:earth", "revision": 0, "rules": [], "expect": "place" },
    { "name": "a repository place with no id", "place": "repository:", "revision": 0, "rules": [], "expect": "place" },
    { "name": "a role the catalogue does not hold", "place": "repository:daoris", "revision": 0,
      "rules": [{ "id": "x", "count": "quiet", "at": 1, "do": "next", "roles": ["wizard"] }], "expect": "roles" },
    { "name": "an empty role list", "place": "repository:daoris", "revision": 0,
      "rules": [{ "id": "x", "count": "quiet", "at": 1, "do": "next", "roles": [] }], "expect": "roles" },
    { "name": "a move with no moves rule anywhere", "place": "machine", "revision": 1,
      "rules": [{ "id": "t", "count": "tries", "at": 5, "do": "hold" }, { "id": "q", "count": "quiet", "at": 1, "do": "next" }], "expect": "moves-unbounded", "expectPlace": "machine" },
    { "name": "a wider write leaving a narrower place's move unbounded names the narrower place",
      "held": [{ "place": "machine", "revision": 1, "rules": "base" }, { "place": "repository:daoris", "revision": 1, "rules": [{ "id": "r-1", "count": "quiet", "at": 1, "do": "next" }] }],
      "place": "machine", "revision": 1,
      "rules": [{ "id": "t", "count": "tries", "at": 5, "do": "hold" }], "expect": "moves-unbounded", "expectPlace": "repository:daoris" },
    { "name": "off on moves at a place whose move rule it leaves unbounded",
      "held": [{ "place": "machine", "revision": 1, "rules": "base" }, { "place": "repository:daoris", "revision": 1, "rules": [{ "id": "r-1", "count": "quiet", "at": 1, "do": "weighted" }] }],
      "place": "repository:daoris", "revision": 1,
      "rules": [{ "id": "r-1", "count": "quiet", "at": 1, "do": "weighted" }, { "id": "r-2", "count": "moves", "at": 1, "do": "off" }], "expect": "moves-unbounded", "expectPlace": "repository:daoris" },
    { "name": "a role's own moves rule bounds only that role",
      "place": "repository:daoris", "revision": 0,
      "rules": [{ "id": "r-1", "count": "quiet", "at": 1, "do": "weighted" }, { "id": "r-2", "count": "moves", "at": 1, "do": "off", "roles": ["build"] }],
      "expect": "moves-unbounded", "expectPlace": "repository:daoris", "expectRole": "build" },
    { "name": "no tries rule at the machine", "place": "machine", "revision": 1, "rules": [], "expect": "tries-unbounded", "expectPlace": "machine" },
    { "name": "a wider write leaving a narrower place with no tries rule names the narrower place",
      "held": [{ "place": "machine", "revision": 1, "rules": "base" }, { "place": "repository:daoris", "revision": 1, "rules": [{ "id": "r-1", "count": "quiet", "at": 1, "do": "ask" }] }],
      "place": "machine", "revision": 1,
      "rules": [{ "id": "m-mv", "count": "moves", "at": 3, "do": "ask" }], "expect": "tries-unbounded", "expectPlace": "repository:daoris" },
    { "name": "a role's tries rule at a place does not leave the other roles unbounded: they inherit the machine's",
      "place": "repository:daoris", "revision": 0, "rules": [{ "id": "r-1", "count": "tries", "at": 2, "do": "hold", "roles": ["build"] }], "expect": null },
    { "name": "refer before it is offered", "place": "machine", "revision": 1,
      "rules": [{ "id": "x", "count": "answers-alone", "at": 2, "do": "refer" }, { "id": "t", "count": "tries", "at": 5, "do": "hold" }], "expect": "refer-not-offered" },
    { "name": "refer once offered", "place": "machine", "revision": 1, "referOffered": true,
      "rules": [{ "id": "x", "count": "answers-alone", "at": 2, "do": "refer" }, { "id": "t", "count": "tries", "at": 5, "do": "hold" }], "expect": null },
    { "name": "a revision that moved", "place": "machine", "revision": 0, "rules": "base", "expect": "revision" }
  ],
  "effective": [
    { "name": "the line's own place beats the repository's and the machine's",
      "sets": [
        { "place": "machine", "rules": [{ "id": "m", "count": "answers-alone", "at": 2, "do": "hold" }] },
        { "place": "repository:daoris", "rules": [{ "id": "r", "count": "answers-alone", "at": 4, "do": "hold" }] },
        { "place": "line:7", "rules": [{ "id": "l", "count": "answers-alone", "at": 6, "do": "hold" }] }],
      "line": "7", "repository": "daoris", "role": "build", "expect": { "answers-alone": ["l"] } },
    { "name": "the repository's replaces the machine's, a count the repository holds none on falls to the machine",
      "sets": [
        { "place": "machine", "rules": [{ "id": "m-aa", "count": "answers-alone", "at": 2, "do": "hold" }, { "id": "m-f", "count": "failures", "at": 3, "do": "hold" }] },
        { "place": "repository:daoris", "rules": [{ "id": "r-aa", "count": "answers-alone", "at": 4, "do": "hold" }] }],
      "repository": "daoris", "role": "build", "expect": { "answers-alone": ["r-aa"], "failures": ["m-f"] } },
    { "name": "a line in another repository reads the machine's",
      "sets": [
        { "place": "machine", "rules": [{ "id": "m-aa", "count": "answers-alone", "at": 2, "do": "hold" }] },
        { "place": "repository:daoris", "rules": [{ "id": "r-aa", "count": "answers-alone", "at": 4, "do": "hold" }] }],
      "repository": "other", "role": "build", "expect": { "answers-alone": ["m-aa"] } },
    { "name": "the workspace sits between the repository and the machine",
      "sets": [
        { "place": "machine", "rules": [{ "id": "m", "count": "answers-alone", "at": 2, "do": "hold" }] },
        { "place": "workspace:w1", "rules": [{ "id": "w", "count": "answers-alone", "at": 3, "do": "hold" }] }],
      "repository": "daoris", "workspace": "w1", "role": "build", "expect": { "answers-alone": ["w"] } },
    { "name": "a Chat line under the machine's rule where the repository holds only a Build rule",
      "sets": [
        { "place": "machine", "rules": [{ "id": "m-aa", "count": "answers-alone", "at": 2, "do": "hold" }] },
        { "place": "repository:daoris", "rules": [{ "id": "r-aa-build", "count": "answers-alone", "at": 5, "do": "hold", "roles": ["build"] }] }],
      "repository": "daoris", "role": "chat", "expect": { "answers-alone": ["m-aa"] } },
    { "name": "a Build line in that repository reads the Build rule",
      "sets": [
        { "place": "machine", "rules": [{ "id": "m-aa", "count": "answers-alone", "at": 2, "do": "hold" }] },
        { "place": "repository:daoris", "rules": [{ "id": "r-aa-build", "count": "answers-alone", "at": 5, "do": "hold", "roles": ["build"] }] }],
      "repository": "daoris", "role": "build", "expect": { "answers-alone": ["r-aa-build"] } },
    { "name": "within a place the rules naming the role replace those naming none",
      "sets": [
        { "place": "repository:daoris", "rules": [
          { "id": "any", "count": "failures", "at": 3, "do": "hold" },
          { "id": "build", "count": "failures", "at": 5, "do": "hold", "roles": ["build"] }] }],
      "repository": "daoris", "role": "build", "expect": { "failures": ["build"] } },
    { "name": "and the others read the rule naming none",
      "sets": [
        { "place": "repository:daoris", "rules": [
          { "id": "any", "count": "failures", "at": 3, "do": "hold" },
          { "id": "build", "count": "failures", "at": 5, "do": "hold", "roles": ["build"] }] }],
      "repository": "daoris", "role": "helper", "expect": { "failures": ["any"] } },
    { "name": "a line with no working role reads only the rules naming none",
      "sets": [
        { "place": "repository:daoris", "rules": [
          { "id": "any", "count": "failures", "at": 3, "do": "hold" },
          { "id": "build", "count": "failures", "at": 5, "do": "hold", "roles": ["build"] }] }],
      "repository": "daoris", "role": null, "expect": { "failures": ["any"] } },
    { "name": "off at the repository ends the inheritance",
      "sets": [
        { "place": "machine", "rules": [{ "id": "m-aa", "count": "answers-alone", "at": 2, "do": "hold" }, { "id": "m-f", "count": "failures", "at": 3, "do": "hold" }] },
        { "place": "repository:daoris", "rules": [{ "id": "r-off", "count": "answers-alone", "at": 1, "do": "off" }] }],
      "repository": "daoris", "role": "build", "expect": { "failures": ["m-f"] } },
    { "name": "off naming a role ends the inheritance for that role alone",
      "sets": [
        { "place": "machine", "rules": [{ "id": "m-aa", "count": "answers-alone", "at": 2, "do": "hold" }] },
        { "place": "repository:daoris", "rules": [{ "id": "r-off", "count": "answers-alone", "at": 1, "do": "off", "roles": ["build"] }] }],
      "repository": "daoris", "role": "build", "expect": {} },
    { "name": "and the other role still reads the machine's",
      "sets": [
        { "place": "machine", "rules": [{ "id": "m-aa", "count": "answers-alone", "at": 2, "do": "hold" }] },
        { "place": "repository:daoris", "rules": [{ "id": "r-off", "count": "answers-alone", "at": 1, "do": "off", "roles": ["build"] }] }],
      "repository": "daoris", "role": "chat", "expect": { "answers-alone": ["m-aa"] } },
    { "name": "an off at a wider place does not undo a narrower place's rule",
      "sets": [
        { "place": "machine", "rules": [{ "id": "m-off", "count": "answers-alone", "at": 1, "do": "off" }] },
        { "place": "repository:daoris", "rules": [{ "id": "r-aa", "count": "answers-alone", "at": 4, "do": "hold" }] }],
      "repository": "daoris", "role": "build", "expect": { "answers-alone": ["r-aa"] } },
    { "name": "several rules on one count at one place make a ladder, lowest at first",
      "sets": [
        { "place": "machine", "rules": [{ "id": "hold5", "count": "tries", "at": 5, "do": "hold" }, { "id": "weigh2", "count": "tries", "at": 2, "do": "weighted" }] }],
      "role": "build", "expect": { "tries": ["weigh2", "hold5"] } }
  ]
}
