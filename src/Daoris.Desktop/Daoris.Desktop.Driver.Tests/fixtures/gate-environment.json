        "pass": [],
        "hold": "h-7",
        "expect": { "Path": "X:/bin", "MSBUILDDISABLENODEREUSE": "1", "DOTNET_CLI_USE_MSBUILD_SERVER": "0", "UseSharedCompilation": "false", "DAORIS_ADMISSION_HOLD": "h-7" }
      },
      {
        "name": "no hold, no marker",
