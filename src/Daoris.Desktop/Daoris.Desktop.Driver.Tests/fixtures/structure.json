    "Driver.Intake.cs": "the loop's part for intake (Loop): the use case it holds moves to Quests' Application when that module is layered",
    "Driver.Opinion.cs": "the loop's part for second opinions (Loop): the use case it holds moves to Review's Application when that module is layered",
    "Driver.OpinionDelivery.cs": "the loop's part for second opinions (Loop): the use case it holds moves to Review's Application when that module is layered",
    "Driver.OpinionGate.cs": "the loop's part for second opinions (Loop): the use case it holds moves to Review's Application when that module is layered",
    "Driver.Workflow.cs": "the loop's part for workflow runs (Loop): the use case it holds moves to Workflows' Application when that module is layered",
    "EvidenceReader.cs": "a done's evidence (Quests), read from a tree's commit with git (Trees)",
    "LandingPlugins.cs": "the landing (Trees), and the plugin wire it speaks (Plugins)",
    "SessionSay.cs": "a person's words to a session (Conversations), and the requests that carry them (Sessions)"
