<Project>

  <Import Project="$(MSBuildThisFileDirectory)..\..\Directory.Build.props" />

  <!--
    Shared build settings for the desktop tree. Mirrors the service tree's so anyone moving between
    them meets the same setup.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- BOM-less UTF-8 sources mojibake on a CJK-locale machine without this: csc reads them as ANSI.
         Inherited from the family rather than rediscovered. -->
    <CodePage>65001</CodePage>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Nothing here is published as a package. The desktop app is a deployable; the only package this
         repository ships is the CLI, which is Node. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    A build's version is the release's: canon/canon.json's, which the release stamps and the publish writes into a stage's
    build.json. Every desktop assembly carries it, so the launcher's product version, the rollback's running build and a stage's
    manifest read one number. Unstamped, an assembly says the SDK's 1.0.0, above every release, and every stage reads as a going back.
  -->
  <PropertyGroup>
    <DaorisRelease>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\canon\canon.json'))</DaorisRelease>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($(DaorisRelease), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</Version>
  </PropertyGroup>

  <!--
    A declaration's name is banned by symbol outside the store (REPOCONFIG1), so the compiler finds every reader that names one. Every
    desktop project that ships carries the analyzer and the driver's one list; the tests name the store's members to prove it and do not.
    Where a use is allowed is the one `.editorconfig` beside this file, and DeclarationBoundaryTests walks every use itself.
  -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)Daoris.Desktop.Driver/BannedSymbols.txt" Link="BannedSymbols.txt" />
  </ItemGroup>

  <!--
    The banned effects of the layers' census (process starts, sleeps, the wall clock, sockets: src/BannedSymbols.Effects.txt), which
    an application or unit-test project takes by setting DaorisBannedEffects once its uses are each allowed by a section of the one
    .editorconfig and the allowance only shrinks. Off, nothing here changes; the layered libraries (src/Layers.props) hold them already.
  -->
  <ItemGroup Condition="'$(DaorisBannedEffects)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" Condition="'$(IsTestProject)' == 'true'" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\BannedSymbols.Effects.txt" />
  </ItemGroup>

  <!--
    The store's engine types (src/BannedSymbols.Store.txt), which an application or unit-test project takes by setting DaorisBannedStore
    once it names none: the engine is the SQLite adapter's and the application asks the ports for its connections. Kept apart from the
    effects above so a project takes the one its uses allow, each row of the census taking its own symbols to zero for what it moved.
  -->
  <ItemGroup Condition="'$(DaorisBannedStore)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" Condition="'$(IsTestProject)' == 'true'" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\BannedSymbols.Store.txt" />
  </ItemGroup>

</Project>
