<Project>

  <!--
    Shared build settings for the desktop tree. Mirrors the service tree's so anyone moving between
    them meets the same setup.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- BOM-less UTF-8 sources mojibake on a CJK-locale machine without this: csc reads them as ANSI.
         Inherited from the family rather than rediscovered. -->
    <CodePage>65001</CodePage>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Nothing here is published as a package. The desktop app is a deployable; the only package this
         repository ships is the CLI, which is Node. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    A build's version is the release's: canon/canon.json's, which the release stamps and the publish writes into a stage's
    build.json. Every desktop assembly carries it, so the launcher's product version, the rollback's running build and a stage's
    manifest read one number. Unstamped, an assembly says the SDK's 1.0.0, above every release, and every stage reads as a going back.
  -->
  <PropertyGroup>
    <DaorisRelease>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\canon\canon.json'))</DaorisRelease>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($(DaorisRelease), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</Version>
  </PropertyGroup>

</Project>
