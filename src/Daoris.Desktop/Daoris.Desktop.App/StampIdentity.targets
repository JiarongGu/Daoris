<Project>

  <!--
    Daoris's face and name on its executable (CHR4, D93). On Chromium, Shenora.Chromium's layout copies CEF's
    bootstrap in as the application's exe, and a copied bootstrap carries CEF's icon and CEF's version info:
    Explorer and a pinned taskbar button showed CEF's logo, and Task Manager and the taskbar's group named the
    window "CEF Bootstrap Application". `ApplicationIcon` and the assembly attributes stamp the assembly, which is
    no longer the exe. So after the layout (a build) and after the publish layout, the launcher's icon resources are
    replaced by the images in `daoris.ico`, and its version resource by one that names Daoris: every existing icon
    group, icon and version entry removed, whatever its name and language, and one of each put in their place.

    Skipped when the layout is off (`ShenoraChromiumLayout=false`) or the launcher is not there.
  -->

  <UsingTask TaskName="DaorisStampIdentity" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Executable ParameterType="System.String" Required="true" />
      <Icon ParameterType="System.String" Required="true" />
      <Name ParameterType="System.String" Required="true" />
      <Version ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.Collections.Generic;
using System.IO;
using System.Runtime.InteropServices;
using System.Text;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

public sealed class DaorisStampIdentity : Task
{
    [Required] public string Executable { get; set; }
    [Required] public string Icon { get; set; }
    [Required] public string Name { get; set; }
    [Required] public string Version { get; set; }

    private const int RT_ICON = 3;
    private const int RT_GROUP_ICON = 14;
    private const int RT_VERSION = 16;
    private const ushort EnglishUnitedStates = 0x0409;
    private const uint LOAD_LIBRARY_AS_DATAFILE = 0x2;

    private delegate bool EnumNames(IntPtr module, IntPtr type, IntPtr name, IntPtr param);
    private delegate bool EnumLanguages(IntPtr module, IntPtr type, IntPtr name, ushort language, IntPtr param);

    [DllImport("kernel32.dll", SetLastError = true, CharSet = CharSet.Unicode)]
    private static extern IntPtr LoadLibraryEx(string path, IntPtr file, uint flags);
    [DllImport("kernel32.dll")] private static extern bool FreeLibrary(IntPtr module);
    [DllImport("kernel32.dll", CharSet = CharSet.Unicode)]
    private static extern bool EnumResourceNames(IntPtr module, IntPtr type, EnumNames callback, IntPtr param);
    [DllImport("kernel32.dll", CharSet = CharSet.Unicode)]
    private static extern bool EnumResourceLanguages(IntPtr module, IntPtr type, IntPtr name, EnumLanguages callback, IntPtr param);
    [DllImport("kernel32.dll", SetLastError = true, CharSet = CharSet.Unicode)]
    private static extern IntPtr BeginUpdateResource(string path, bool deleteExisting);
    [DllImport("kernel32.dll", SetLastError = true, CharSet = CharSet.Unicode)]
    private static extern bool UpdateResource(IntPtr update, IntPtr type, IntPtr name, ushort language, byte[] data, uint size);
    [DllImport("kernel32.dll", SetLastError = true)]
    private static extern bool EndUpdateResource(IntPtr update, bool discard);

    // A resource named by a string is kept as its string: the pointer EnumResourceNames hands over dies with the call.
    private sealed class Entry { public IntPtr Type; public int Id; public string Label; public ushort Language; }

    public override bool Execute()
    {
        if (!File.Exists(Executable)) { Log.LogMessage(MessageImportance.Low, "No launcher at {0}; nothing to stamp.", Executable); return true; }

        // 🔴 A file copied a moment ago is often still held — by the scanner that looks at every new executable,
        // or by an engine process of the run just stopped — and the save fails with access denied or a sharing
        // violation. Seen on the second build after a stop. Retried briefly; anything else fails at once.
        for (var attempt = 1; ; attempt++)
        {
            int error;
            string failure;
            if (TryStamp(out error, out failure)) return true;
            if ((error != 5 && error != 32) || attempt == 20) { Log.LogError(failure); return false; }
            System.Threading.Thread.Sleep(250);
        }
    }

    private bool TryStamp(out int code, out string failure)
    {
        code = 0;
        failure = null;
        var existing = Existing();
        var images = Images(File.ReadAllBytes(Icon));
        var version = VersionResource();

        var update = BeginUpdateResource(Executable, false);
        if (update == IntPtr.Zero)
        {
            code = Marshal.GetLastWin32Error();
            failure = "Could not open " + Executable + " to stamp it (error " + code + ").";
            return false;
        }

        var labels = new List<IntPtr>();
        try
        {
            foreach (var entry in existing)
            {
                var name = entry.Label is null ? (IntPtr)entry.Id : Marshal.StringToHGlobalUni(entry.Label);
                if (entry.Label is not null) labels.Add(name);
                Put(update, entry.Type, name, entry.Language, null, "removing a resource");
            }

            // One group, named 1, pointing at icons 1..n: the first group is what Windows shows for a file.
            var group = new MemoryStream();
            var writer = new BinaryWriter(group);
            writer.Write((ushort)0); writer.Write((ushort)1); writer.Write((ushort)images.Count);
            for (var i = 0; i < images.Count; i++)
            {
                Put(update, (IntPtr)RT_ICON, (IntPtr)(i + 1), 0, images[i].Data, "writing an icon image");
                writer.Write(images[i].Header, 0, 12);    // width, height, colours, reserved, planes, bit count, size
                writer.Write((ushort)(i + 1));             // the icon's resource id, where the file had its offset
            }
            Put(update, (IntPtr)RT_GROUP_ICON, (IntPtr)1, 0, group.ToArray(), "writing the icon group");
            Put(update, (IntPtr)RT_VERSION, (IntPtr)1, EnglishUnitedStates, version, "writing the version");
        }
        catch (Exception error)
        {
            EndUpdateResource(update, true);
            foreach (var label in labels) Marshal.FreeHGlobal(label);
            failure = "Stamping Daoris onto " + Executable + ": " + error.Message;
            return false;
        }

        var ended = EndUpdateResource(update, false);
        if (!ended) code = Marshal.GetLastWin32Error();
        foreach (var label in labels) Marshal.FreeHGlobal(label);
        if (!ended)
        {
            failure = "Saving " + Executable + " with Daoris's face failed (error " + code + ").";
            return false;
        }

        Log.LogMessage(MessageImportance.Normal, "Stamped {0}'s icon and name onto {1}.", Name, Path.GetFileName(Executable));
        return true;
    }

    private static void Put(IntPtr update, IntPtr type, IntPtr name, ushort language, byte[] data, string what)
    {
        if (!UpdateResource(update, type, name, language, data, data is null ? 0u : (uint)data.Length))
            throw new InvalidOperationException(what + " failed (error " + Marshal.GetLastWin32Error() + ")");
    }

    private List<Entry> Existing()
    {
        var found = new List<Entry>();
        var module = LoadLibraryEx(Executable, IntPtr.Zero, LOAD_LIBRARY_AS_DATAFILE);
        if (module == IntPtr.Zero) return found;
        try
        {
            foreach (var type in new[] { (IntPtr)RT_GROUP_ICON, (IntPtr)RT_ICON, (IntPtr)RT_VERSION })
            {
                EnumResourceNames(module, type, (m, t, name, p) =>
                {
                    var isId = ((long)name >> 16) == 0;
                    var id = isId ? (int)(long)name : 0;
                    var label = isId ? null : Marshal.PtrToStringUni(name);
                    EnumResourceLanguages(m, t, name, (m2, t2, n2, language, p2) =>
                    {
                        found.Add(new Entry { Type = type, Id = id, Label = label, Language = language });
                        return true;
                    }, IntPtr.Zero);
                    return true;
                }, IntPtr.Zero);
            }
        }
        finally { FreeLibrary(module); }
        return found;
    }

    private sealed class Image { public byte[] Header; public byte[] Data; }

    // ICONDIR, then one 16-byte ICONDIRENTRY per image: 12 bytes of shape and size, then the image's offset.
    private static List<Image> Images(byte[] file)
    {
        if (file.Length < 6 || BitConverter.ToUInt16(file, 2) != 1) throw new InvalidDataException("not an .ico file");
        var count = BitConverter.ToUInt16(file, 4);
        var images = new List<Image>();
        for (var i = 0; i < count; i++)
        {
            var at = 6 + i * 16;
            var size = BitConverter.ToInt32(file, at + 8);
            var offset = BitConverter.ToInt32(file, at + 12);
            var header = new byte[12];
            Array.Copy(file, at, header, 0, 12);
            var data = new byte[size];
            Array.Copy(file, offset, data, 0, size);
            images.Add(new Image { Header = header, Data = data });
        }
        return images;
    }

    // VS_VERSIONINFO: a fixed block, then StringFileInfo (one US English, Unicode table) and VarFileInfo. Every node
    // is { length, value length, type, key, padding to 4, value, padding, children }, its length covering all of it.
    private byte[] VersionResource()
    {
        var parts = (Version + ".0.0.0").Split('.');
        ushort Part(int i) { ushort v; return ushort.TryParse(parts[i], out v) ? v : (ushort)0; }
        var major = Part(0); var minor = Part(1); var build = Part(2); var revision = Part(3);
        var dotted = major + "." + minor + "." + build + "." + revision;

        var fixedInfo = new MemoryStream();
        var f = new BinaryWriter(fixedInfo);
        f.Write(0xFEEF04BDu); f.Write(0x00010000u);
        f.Write(((uint)major << 16) | minor); f.Write(((uint)build << 16) | revision);
        f.Write(((uint)major << 16) | minor); f.Write(((uint)build << 16) | revision);
        f.Write(0x3Fu); f.Write(0u); f.Write(0x40004u); f.Write(1u); f.Write(0u); f.Write(0u); f.Write(0u);

        var strings = new List<byte[]>();
        foreach (var pair in new[]
        {
            new[] { "CompanyName", Name }, new[] { "FileDescription", Name }, new[] { "FileVersion", dotted },
            new[] { "InternalName", Path.GetFileNameWithoutExtension(Executable) },
            new[] { "OriginalFilename", Path.GetFileName(Executable) }, new[] { "ProductName", Name },
            new[] { "ProductVersion", dotted },
        })
        {
            strings.Add(Node(pair[0], Encoding.Unicode.GetBytes(pair[1] + "\0"), (ushort)(pair[1].Length + 1), 1, null));
        }

        var table = Node("040904b0", null, 0, 1, strings);
        var stringInfo = Node("StringFileInfo", null, 0, 1, new List<byte[]> { table });
        var translation = Node("Translation", BitConverter.GetBytes(0x04B00409u), 4, 0, null);
        var varInfo = Node("VarFileInfo", null, 0, 1, new List<byte[]> { translation });
        return Node("VS_VERSION_INFO", fixedInfo.ToArray(), (ushort)fixedInfo.Length, 0,
            new List<byte[]> { stringInfo, varInfo });
    }

    // A node's length covers no padding after its end, so padding goes BEFORE whatever follows: the value
    // starts aligned after the key, and each child starts aligned after what precedes it.
    private static byte[] Node(string key, byte[] value, ushort valueLength, ushort type, List<byte[]> children)
    {
        var body = new MemoryStream();
        var w = new BinaryWriter(body);
        w.Write((ushort)0); w.Write(valueLength); w.Write(type);
        w.Write(Encoding.Unicode.GetBytes(key + "\0"));
        if (value is not null) { w.Flush(); Pad(body); w.Write(value); }
        if (children is not null) foreach (var child in children) { w.Flush(); Pad(body); w.Write(child); }
        w.Flush();
        var bytes = body.ToArray();
        BitConverter.GetBytes((ushort)bytes.Length).CopyTo(bytes, 0);
        return bytes;
    }

    private static void Pad(Stream stream)
    {
        while (stream.Length % 4 != 0) stream.WriteByte(0);
    }
}
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Absolute: the native resource API resolves a relative path against the process's directory, which is
       not the project's under MSBuild, while File.Exists had found it — so the stamp failed with error 2. -->
  <PropertyGroup>
    <_DaorisLauncher>$(AssemblyName.Substring(0, $([MSBuild]::Subtract($(AssemblyName.Length), 4)))).exe</_DaorisLauncher>
    <_DaorisIcon>$(MSBuildThisFileDirectory)daoris.ico</_DaorisIcon>
  </PropertyGroup>

  <Target Name="DaorisStampIdentity" AfterTargets="ShenoraChromiumLayout" Condition="'$(ShenoraChromiumLayout)' != 'false'">
    <DaorisStampIdentity Executable="$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(OutDir)$(_DaorisLauncher)'))" Icon="$(_DaorisIcon)" Name="Daoris" Version="$(FileVersion)" />
  </Target>

  <Target Name="DaorisStampPublishedIdentity" AfterTargets="ShenoraChromiumPublishLayout" Condition="'$(ShenoraChromiumLayout)' != 'false'">
    <DaorisStampIdentity Executable="$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(PublishDir)$(_DaorisLauncher)'))" Icon="$(_DaorisIcon)" Name="Daoris" Version="$(FileVersion)" />
  </Target>

</Project>
