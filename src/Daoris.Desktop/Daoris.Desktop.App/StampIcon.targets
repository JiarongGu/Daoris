<Project>

  <!--
    Daoris's face on its executable (CHR4). On Chromium, Shenora.Chromium's layout copies CEF's bootstrap in as
    `Daoris.exe`, and a copied bootstrap carries CEF's icon: Explorer, a pinned taskbar button and the Start menu
    all showed CEF's logo on Daoris. `ApplicationIcon` stamps the assembly, which is no longer the exe. So after
    the layout (a build) and after the publish layout, the icon resources in the launcher are replaced by the
    images in `daoris.ico`: every existing icon group and icon removed, whatever its name and language, and one
    group put in their place.

    Skipped when the layout is off (`ShenoraChromiumLayout=false`) or the launcher is not there.
  -->

  <UsingTask TaskName="DaorisStampIcon" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Executable ParameterType="System.String" Required="true" />
      <Icon ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs"><![CDATA[
using System;
using System.Collections.Generic;
using System.IO;
using System.Runtime.InteropServices;
using Microsoft.Build.Framework;
using Microsoft.Build.Utilities;

public sealed class DaorisStampIcon : Task
{
    [Required] public string Executable { get; set; }
    [Required] public string Icon { get; set; }

    private const int RT_ICON = 3;
    private const int RT_GROUP_ICON = 14;
    private const uint LOAD_LIBRARY_AS_DATAFILE = 0x2;

    private delegate bool EnumNames(IntPtr module, IntPtr type, IntPtr name, IntPtr param);
    private delegate bool EnumLanguages(IntPtr module, IntPtr type, IntPtr name, ushort language, IntPtr param);

    [DllImport("kernel32.dll", SetLastError = true, CharSet = CharSet.Unicode)]
    private static extern IntPtr LoadLibraryEx(string path, IntPtr file, uint flags);
    [DllImport("kernel32.dll")] private static extern bool FreeLibrary(IntPtr module);
    [DllImport("kernel32.dll", CharSet = CharSet.Unicode)]
    private static extern bool EnumResourceNames(IntPtr module, IntPtr type, EnumNames callback, IntPtr param);
    [DllImport("kernel32.dll", CharSet = CharSet.Unicode)]
    private static extern bool EnumResourceLanguages(IntPtr module, IntPtr type, IntPtr name, EnumLanguages callback, IntPtr param);
    [DllImport("kernel32.dll", SetLastError = true, CharSet = CharSet.Unicode)]
    private static extern IntPtr BeginUpdateResource(string path, bool deleteExisting);
    [DllImport("kernel32.dll", SetLastError = true, CharSet = CharSet.Unicode)]
    private static extern bool UpdateResource(IntPtr update, IntPtr type, IntPtr name, ushort language, byte[] data, uint size);
    [DllImport("kernel32.dll", SetLastError = true)]
    private static extern bool EndUpdateResource(IntPtr update, bool discard);

    // A resource named by a string is kept as its string: the pointer EnumResourceNames hands over dies with the call.
    private sealed class Entry { public IntPtr Type; public int Id; public string Name; public ushort Language; }

    public override bool Execute()
    {
        if (!File.Exists(Executable)) { Log.LogMessage(MessageImportance.Low, "No launcher at {0}; nothing to stamp.", Executable); return true; }

        var existing = Existing();
        var images = Images(File.ReadAllBytes(Icon));

        var update = BeginUpdateResource(Executable, false);
        if (update == IntPtr.Zero) { Log.LogError("Could not open {0} to stamp its icon (error {1}).", Executable, Marshal.GetLastWin32Error()); return false; }

        var names = new List<IntPtr>();
        try
        {
            foreach (var entry in existing)
            {
                var name = entry.Name is null ? (IntPtr)entry.Id : Marshal.StringToHGlobalUni(entry.Name);
                if (entry.Name is not null) names.Add(name);
                if (!UpdateResource(update, entry.Type, name, entry.Language, null, 0))
                    throw new InvalidOperationException("removing an icon resource failed (error " + Marshal.GetLastWin32Error() + ")");
            }

            // One group, named 1, pointing at icons 1..n: the first group is what Windows shows for a file.
            var group = new MemoryStream();
            var writer = new BinaryWriter(group);
            writer.Write((ushort)0); writer.Write((ushort)1); writer.Write((ushort)images.Count);
            for (var i = 0; i < images.Count; i++)
            {
                var image = images[i];
                if (!UpdateResource(update, (IntPtr)RT_ICON, (IntPtr)(i + 1), 0, image.Data, (uint)image.Data.Length))
                    throw new InvalidOperationException("writing an icon image failed (error " + Marshal.GetLastWin32Error() + ")");
                writer.Write(image.Header, 0, 12);          // width, height, colours, reserved, planes, bit count, size
                writer.Write((ushort)(i + 1));               // the icon's resource id, where the file had its offset
            }
            var bytes = group.ToArray();
            if (!UpdateResource(update, (IntPtr)RT_GROUP_ICON, (IntPtr)1, 0, bytes, (uint)bytes.Length))
                throw new InvalidOperationException("writing the icon group failed (error " + Marshal.GetLastWin32Error() + ")");
        }
        catch (Exception error)
        {
            EndUpdateResource(update, true);
            foreach (var name in names) Marshal.FreeHGlobal(name);
            Log.LogError("Stamping Daoris's icon onto {0}: {1}", Executable, error.Message);
            return false;
        }

        var ended = EndUpdateResource(update, false);
        foreach (var name in names) Marshal.FreeHGlobal(name);
        if (!ended) { Log.LogError("Saving {0} with Daoris's icon failed (error {1}).", Executable, Marshal.GetLastWin32Error()); return false; }

        Log.LogMessage(MessageImportance.Normal, "Stamped {0} image(s) of {1} onto {2}.", images.Count, Path.GetFileName(Icon), Path.GetFileName(Executable));
        return true;
    }

    private List<Entry> Existing()
    {
        var found = new List<Entry>();
        var module = LoadLibraryEx(Executable, IntPtr.Zero, LOAD_LIBRARY_AS_DATAFILE);
        if (module == IntPtr.Zero) return found;
        try
        {
            foreach (var type in new[] { (IntPtr)RT_GROUP_ICON, (IntPtr)RT_ICON })
            {
                EnumResourceNames(module, type, (m, t, name, p) =>
                {
                    var isId = ((long)name >> 16) == 0;
                    var id = isId ? (int)(long)name : 0;
                    var text = isId ? null : Marshal.PtrToStringUni(name);
                    EnumResourceLanguages(m, t, name, (m2, t2, n2, language, p2) =>
                    {
                        found.Add(new Entry { Type = type, Id = id, Name = text, Language = language });
                        return true;
                    }, IntPtr.Zero);
                    return true;
                }, IntPtr.Zero);
            }
        }
        finally { FreeLibrary(module); }
        return found;
    }

    private sealed class Image { public byte[] Header; public byte[] Data; }

    // ICONDIR, then one 16-byte ICONDIRENTRY per image: 12 bytes of shape and size, then the image's offset.
    private static List<Image> Images(byte[] file)
    {
        if (file.Length < 6 || BitConverter.ToUInt16(file, 2) != 1) throw new InvalidDataException("not an .ico file");
        var count = BitConverter.ToUInt16(file, 4);
        var images = new List<Image>();
        for (var i = 0; i < count; i++)
        {
            var at = 6 + i * 16;
            var size = BitConverter.ToInt32(file, at + 8);
            var offset = BitConverter.ToInt32(file, at + 12);
            var header = new byte[12];
            Array.Copy(file, at, header, 0, 12);
            var data = new byte[size];
            Array.Copy(file, offset, data, 0, size);
            images.Add(new Image { Header = header, Data = data });
        }
        return images;
    }
}
      ]]></Code>
    </Task>
  </UsingTask>

  <PropertyGroup>
    <_DaorisLauncher>$(AssemblyName.Substring(0, $([MSBuild]::Subtract($(AssemblyName.Length), 4)))).exe</_DaorisLauncher>
    <_DaorisIcon>$(MSBuildThisFileDirectory)daoris.ico</_DaorisIcon>
  </PropertyGroup>

  <Target Name="DaorisStampIcon" AfterTargets="ShenoraChromiumLayout" Condition="'$(ShenoraChromiumLayout)' != 'false'">
    <DaorisStampIcon Executable="$(OutDir)$(_DaorisLauncher)" Icon="$(_DaorisIcon)" />
  </Target>

  <Target Name="DaorisStampPublishedIcon" AfterTargets="ShenoraChromiumPublishLayout" Condition="'$(ShenoraChromiumLayout)' != 'false'">
    <DaorisStampIcon Executable="$(PublishDir)$(_DaorisLauncher)" Icon="$(_DaorisIcon)" />
  </Target>

</Project>
