<Project Sdk="Microsoft.NET.Sdk">

  <!-- The local driver's shell (D45 part 2, D46): one window that brings up the local service host,
       carries the platform, and runs the driver loop — built on the desktop runtime sibling at a
       RELEASED version (D22). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows TFM here only: the driver library underneath stays plain net10.0, so everything that
         can be tested headless is. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Daoris.Desktop</RootNamespace>
    <!-- On the Chromium it ships (D92, CHR2): the build lays the app out beside CEF, and CEF's launcher
         becomes the exe. It is named from this assembly less `.App`, so the application is
         `Daoris.Desktop.exe`, which an install keeps in `app/` and starts from `Daoris.exe` at its root
         (D93, `Daoris.Desktop.Launcher`). A runtime identifier is what picks CEF's build. -->
    <AssemblyName>Daoris.Desktop.App</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- A known, expected WebView2/WindowsBase reference conflict — demoted exactly as the runtime's
         own consumers demote it. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <!-- The application's own face, everywhere Windows shows one: the executable in Explorer, the
         taskbar, the Alt-Tab list. Drawn by `tools/make-icon.py` and COMMITTED, so no consumer needs
         that script to build this. -->
    <ApplicationIcon>daoris.ico</ApplicationIcon>
    <!-- The name CEF's launcher wears once the kit lays it out (Shenora 0.18, SHEN1): it copies this
         assembly's icon, title, product and version onto `Daoris.Desktop.exe`, which Task Manager and
         a pinned taskbar button otherwise named "CEF Bootstrap Application". -->
    <AssemblyTitle>Daoris</AssemblyTitle>
    <Product>Daoris</Product>
    <!-- The engine's UI languages the page speaks, laid out by the kit (en-US, its fallback, always):
         the other 218 locale files are 47 MB an install never reads. -->
    <ShenoraChromiumLocales>zh-CN</ShenoraChromiumLocales>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shenora.Windows" />
    <!-- Referenced HERE, not only through Shenora.Windows: only a direct reference runs the build that
         fetches the pinned CEF and lays the app out beside its launcher. -->
    <PackageReference Include="Shenora.Chromium" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window's own icon, read from here at run time; the executable's is the kit's copy of
         `ApplicationIcon` above. -->
    <Content Include="daoris.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window's head: the loop, the supervisor and every IPC module the page talks to. Separated
         because none of it is WinForms, and being in here cost it every test it should have had. -->
    <ProjectReference Include="..\Daoris.Desktop.Modules\Daoris.Desktop.Modules.csproj" />
    <ProjectReference Include="..\Daoris.Desktop.Driver\Daoris.Desktop.Driver.csproj" />
  </ItemGroup>

</Project>
