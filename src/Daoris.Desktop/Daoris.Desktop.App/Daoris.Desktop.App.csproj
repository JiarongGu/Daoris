<Project Sdk="Microsoft.NET.Sdk">

  <!-- The local driver's shell (D45 part 2, D46): one window that brings up the local service host,
       carries the platform, and runs the driver loop — built on the desktop runtime sibling at a
       RELEASED version (D22). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows TFM here only: the driver library underneath stays plain net10.0, so everything that
         can be tested headless is. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Daoris.Desktop</RootNamespace>
    <AssemblyName>daoris-desktop</AssemblyName>
    <!-- A known, expected WebView2/WindowsBase reference conflict — demoted exactly as the runtime's
         own consumers demote it. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <!-- The application's own face, everywhere Windows shows one: the executable in Explorer, the
         taskbar, the Alt-Tab list. Drawn by `tools/make-icon.py` and COMMITTED, so no consumer needs
         that script to build this. -->
    <ApplicationIcon>daoris.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shenora.Windows" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window's head: the loop, the supervisor and every IPC module the page talks to. Separated
         because none of it is WinForms, and being in here cost it every test it should have had. -->
    <ProjectReference Include="..\Daoris.Desktop.Modules\Daoris.Desktop.Modules.csproj" />
    <ProjectReference Include="..\Daoris.Desktop.Driver\Daoris.Desktop.Driver.csproj" />
  </ItemGroup>

</Project>
