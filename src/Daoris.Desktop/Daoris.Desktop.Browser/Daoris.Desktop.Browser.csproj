<Project Sdk="Microsoft.NET.Sdk">

  <!-- Daoris's own browser (D78, D84, D85, CHR3): the engine's own Chromium window, in a process of
       its own. It is a process of its own because the engine's debug port reaches every page in its
       process (docs/2026-09-28-chromium-embedding-evidence.md §1), and the shell's page holds the
       bridge. The shell starts it; nothing else does. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Daoris.Desktop.Browser</RootNamespace>
    <AssemblyName>daoris-browser</AssemblyName>
    <!-- The engine's runtime is per architecture, so the build names one. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- bin/<flavour>/<framework>/, as every other project here: the dev loop and the locator find a
         build by that shape (`tools/desktop.mjs` assemblyExe, EngineBrowser.Candidates). -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ApplicationIcon>..\Daoris.Desktop.App\daoris.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CefSharp.WinForms.NETCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- For the arguments the shell starts it with: one parser, beside the code that writes them. -->
    <ProjectReference Include="..\Daoris.Desktop.Modules\Daoris.Desktop.Modules.csproj" />
  </ItemGroup>

</Project>
