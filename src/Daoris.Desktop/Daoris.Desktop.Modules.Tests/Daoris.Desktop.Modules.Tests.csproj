<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Daoris.Desktop.Modules\Daoris.Desktop.Modules.csproj" />
    <!-- The fakes the unit tier shares: the machine's places and seal the test root chooses. -->
    <ProjectReference Include="..\..\Daoris.Testing\Daoris.Testing.csproj" />
    <Using Include="Daoris.Ports.Browser" />
    <!-- The generator of the page's window routes, whose output is held to the marks it reads. -->
    <ProjectReference Include="..\..\..\tools\contracts\ContractsGen.csproj" />
  </ItemGroup>

  <!-- The application CodecPlaybackProcessTests starts as Daoris's browser (D234), built with this project so the test
       starts this checkout's build, on the codecs package's engine, and never an older layout left in its folder. Its
       output is not referenced. Windows only: the application is, and this suite runs headless elsewhere. -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <ProjectReference Include="..\Daoris.Desktop.App\Daoris.Desktop.App.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- The git a test's own fixture starts, past Git for Windows' launcher (GITSTART1, GITSTART6): the driver tests'
         helper, compiled in, so both projects' fixtures start git one way. -->
    <Compile Include="..\Daoris.Desktop.Driver.Tests\TestGit.cs" Link="TestGit.cs" />
    <Compile Include="..\Daoris.Desktop.Driver.Tests\TestPorts.cs" Link="TestPorts.cs" />
    <!-- The machine's liveness the test root answers real processes by, until the Process classes leave the unit tier. -->
    <Compile Include="..\..\Daoris.Adapters\Daoris.Adapters.Machine\ProcessLiveness.cs" Link="ProcessLiveness.cs" />
    <Compile Include="..\Daoris.Desktop.Driver.Tests\TestHomes.cs" Link="TestHomes.cs" />
    <Compile Include="..\Daoris.Desktop.Driver.Tests\ScratchFolders.cs" Link="ScratchFolders.cs" />
    <Compile Include="..\Daoris.Desktop.Driver.Tests\RoutedHandler.cs" Link="RoutedHandler.cs" />
    <Compile Include="..\Daoris.Desktop.Driver.Tests\Poll.cs" Link="Poll.cs" />
    <Compile Include="..\Daoris.Desktop.Driver.Tests\Roles\StaffedRoles.cs" Link="StaffedRoles.cs" />
    <Compile Include="..\Daoris.Desktop.Driver.Tests\Agents\TestDoors.cs" Link="TestDoors.cs" />
    <Compile Include="..\Daoris.Desktop.Driver.Tests\Agents\TestAgent.cs" Link="TestAgent.cs" />
    <!-- The safe removal of a test's scratch home (SCRATCHLEAK1), with the git runner its seeds are built by, held once. -->
    <Compile Include="..\Daoris.Desktop.Driver.Tests\GitFixture.cs" Link="GitFixture.cs" />
    <Compile Include="..\Daoris.Desktop.Driver.Tests\FixtureSpawns.cs" Link="FixtureSpawns.cs" />
    <!-- The sessions' change door answered in the contract's shape by a stand-in service, held once. -->
    <Compile Include="..\Daoris.Desktop.Driver.Tests\Service\SessionChanges.cs" Link="SessionChanges.cs" />
    <Compile Include="..\Daoris.Desktop.Driver.Tests\Service\SessionChangeShape.cs" Link="SessionChangeShape.cs" />
    <Compile Include="..\Daoris.Desktop.Driver.Tests\Trees\GitSeed.cs" Link="GitSeed.cs" />
    <Compile Include="..\Daoris.Desktop.Driver.Tests\Loop\AccountStandIn.cs" Link="AccountStandIn.cs" />
    <!-- The benchmark home of a working machine's size over the service's own host, held once: the shell's reads are counted on it. -->
    <Compile Include="..\Daoris.Desktop.Driver.Tests\Loop\BenchHome.cs" Link="BenchHome.cs" />
    <Compile Include="..\Daoris.Desktop.Driver.Tests\Loop\BenchDoors.cs" Link="BenchDoors.cs" />
    <Compile Include="..\Daoris.Desktop.Driver.Tests\Service\RealServiceHost.cs" Link="RealServiceHost.cs" />
    <Compile Include="..\Daoris.Desktop.Driver.Tests\WorkspaceRoot.cs" Link="WorkspaceRoot.cs" />
    <!-- The scan of every console start's window (CONSOLEWINDOWS1), with the named exemptions, held once. -->
    <Compile Include="..\Daoris.Desktop.Driver.Tests\Platform\NoConsoleStarts.cs" Link="NoConsoleStarts.cs" />
    <Compile Include="..\Daoris.Desktop.Driver.Tests\Platform\TestProcessStarts.cs" Link="TestProcessStarts.cs" />
  </ItemGroup>

</Project>
