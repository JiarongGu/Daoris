<Project Sdk="Microsoft.NET.Sdk">

  <!-- The driver: watch → plan → spawn → observe (D46). A client of the service over HTTP, a process
       supervisor over the adapters, and nothing else — the service holds the state, this holds the
       action. -->
  <PropertyGroup>
    <RootNamespace>Daoris.Driver</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Daoris.Desktop.Driver.Tests" />
  </ItemGroup>

  <!-- The tree guard's hook (PERM3), carried inside the assembly and written under the Daoris home on
       first use: it is found the same way in a scratch run, a test and an install, whatever the
       publish layout. -->
  <ItemGroup>
    <EmbeddedResource Include="hooks\tree-guard.mjs" LogicalName="Daoris.Driver.tree-guard.mjs" />
  </ItemGroup>

  <!-- The plugin kit's templates (PLUG8): what `plugins new` writes into a new plugin's folder. Named
       `.template` so no test runner or gate mistakes them for this repository's own scripts. -->
  <ItemGroup>
    <EmbeddedResource Include="plugin-kit\*.template" LogicalName="Daoris.Driver.plugin-kit.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
