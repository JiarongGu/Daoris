<Project Sdk="Microsoft.NET.Sdk">

  <!-- The driver: watch → plan → spawn → observe (D46). A client of the service over HTTP, a process
       supervisor over the adapters, and nothing else — the service holds the state, this holds the
       action. -->
  <PropertyGroup>
    <RootNamespace>Daoris.Driver</RootNamespace>
    <!-- The store's engine types are the SQLite adapter's: this project names none of them (src/BannedSymbols.Store.txt). -->
    <DaorisBannedStore>true</DaorisBannedStore>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Daoris.Desktop.Driver.Tests" />
    <InternalsVisibleTo Include="Daoris.Desktop.Modules.Tests" />
  </ItemGroup>

  <!-- The service's routes as their declarations, the one project this references: never the service's own, whose store it
       must not reach. -->
  <ItemGroup>
    <ProjectReference Include="../../Daoris.Contracts/Daoris.Contracts.csproj" />
  </ItemGroup>

  <!-- The effect contracts the driver depends on and the adapters implement: the browser's and the machine's so far. -->
  <ItemGroup>
    <ProjectReference Include="../../Daoris.Ports/Daoris.Ports.csproj" />
    <Using Include="Daoris.Ports.Browser" />
    <Using Include="Daoris.Ports.Clocks" />
    <Using Include="Daoris.Ports.Store" />
    <Using Include="System.Data.Common" />
  </ItemGroup>

  <!-- The desktop store's package and its native bundle (FOUNDATION1 z-i, D212 §13.2), pinned at the service's versions in
       Directory.Packages.props and taken by `DesktopStore` alone: never Daoris.Service.Core, whose store is the service's. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <!-- The git library (GITLIB1d): a repository's refs as they are stored, one `Repository` a call, named under `Workplace/Git/` alone;
       its native `git2-*.dll` is laid beside the driver by the `win-x64` publish, as SQLite's is. -->
  <ItemGroup>
    <PackageReference Include="LibGit2Sharp" />
  </ItemGroup>

  <!-- Lyntai's agent layer (AGENTLYNTAI1, D248): taken by the driver alone and named in it by `Agents/Layer/` and the providers' folders
       alone (`LayerCensusTests`). Only Lyntai's local build carries it, so it is referenced only where that build is in use; without
       `local/lyntai-local.props` the driver builds as before, with no Lyntai assembly. -->
  <ItemGroup Condition="'$(DaorisLyntaiLayer)' == 'true'">
    <PackageReference Include="Lyntai.Core" />
    <PackageReference Include="Lyntai.Providers.Basic" />
  </ItemGroup>
  <!-- The adapter over it, and each provider folder's `Layer/` naming its vendor's registration, compile under the same condition alone,
       so a build without the local build is today's driver. -->
  <ItemGroup Condition="'$(DaorisLyntaiLayer)' != 'true'">
    <Compile Remove="Agents\Layer\**" />
    <Compile Remove="Agents\Providers\*\Layer\**" />
  </ItemGroup>

  <!-- The tree guard's hook (PERM3), carried inside the assembly and written under the Daoris home on
       first use: it is found the same way in a scratch run, a test and an install, whatever the
       publish layout. -->
  <ItemGroup>
    <EmbeddedResource Include="Workplace\hooks\tree-guard.mjs" LogicalName="Daoris.Driver.tree-guard.mjs" />
    <EmbeddedResource Include="Workplace\hooks\subagent-worktree.mjs" LogicalName="Daoris.Driver.subagent-worktree.mjs" />
    <EmbeddedResource Include="Agents\Providers\ClaudeCode\hooks\lineage-hook.mjs" LogicalName="Daoris.Driver.lineage-hook.mjs" />
    <EmbeddedResource Include="Agents\Providers\ClaudeCode\hooks\permission-ask.mjs" LogicalName="Daoris.Driver.permission-ask.mjs" />
    <EmbeddedResource Include="Agents\keeper\server-keeper.mjs" LogicalName="Daoris.Driver.server-keeper.mjs" />
  </ItemGroup>

  <!-- The list built in (TOOLS3, D121 §3.1): where each tool's versions download from. A file beside the
       driver, never a resource inside it, because the person can read it and a republish replaces it whole.
       Every build that references the driver (the application, the headless host, the tests) carries it
       beside itself. An install's copy is laid out at app/resources.json by tools/desktop-publish.mjs, the
       one writer there, which also clears it from the application's publish stage; a publish is not asked
       to copy it. -->
  <ItemGroup>
    <None Include="resources.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Each provider's program (AGENTPROVIDER1 row b, part 3; D213): every file under a provider folder's `Program/`, carried by
       this one glob beside every build that references the driver (the tests, the headless host a rehearsal builds), at the path
       it has here. A stand-in's program runs no model and serves no person, so no publish carries it, and a provider added later
       lists nothing here. -->
  <ItemGroup>
    <None Include="Agents\Providers\*\Program\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- The plugin kit's templates (PLUG8): what `plugins new` writes into a new plugin's folder. Named
       `.template` so no test runner or gate mistakes them for this repository's own scripts. -->
  <ItemGroup>
    <EmbeddedResource Include="Plugins\plugin-kit\*.template" LogicalName="Daoris.Driver.plugin-kit.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The defaults Daoris ships (DEFAULTCONFIG1): the fabric's workflows and the agents' structure, one file each, carried inside the
       assembly so every build reads the same. A name keeps its folder, its separator whatever the machine's; the reader makes it `/`. -->
  <ItemGroup>
    <EmbeddedResource Include="Defaults\**\*.json" LogicalName="Daoris.Driver.Defaults/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
