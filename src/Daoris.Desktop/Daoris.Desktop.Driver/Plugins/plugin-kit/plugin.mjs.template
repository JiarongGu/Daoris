// {{name}} (`{{id}}`): a Daoris plugin that speaks.
//
// It is a process of its own, started by the driver, answering over JSON-RPC 2.0 on this process's
// stdin and stdout, one frame per line. README.md says what each point is sent and must answer;
// `node --test` in this folder checks this file against it.
//
// Three rules the driver holds a plugin to:
//   1. stdout is the wire. Nothing but frames goes there; say anything else on stderr (console.error),
//      which the driver shows under this plugin's name.
//   2. What it keeps goes in DAORIS_PLUGIN_DATA, never beside this file: the install folder is replaced
//      whole by the next `daoris plugin add`.
//   3. Every request is answered, and promptly.
//
// Where it is and what it keeps are told in the environment, never guessed:
//   DAORIS_PLUGIN_ID      this plugin's id, as plugin.json declares it
//   DAORIS_PLUGIN_FOLDER  the install folder
//   DAORIS_PLUGIN_DATA    the data folder beside it, which an update never touches
//   DAORIS_HOME           the Daoris home the driver runs against
//   DAORIS_PLUGIN_PRIVATE its private storage, where plugin.json declares `interfaces.storage` and the person left it on
import { createInterface } from 'node:readline';
import { records } from './storage.mjs';
{{imports}}
const send = (frame) => process.stdout.write(`${JSON.stringify(frame)}\n`);
const say = (text) => console.error(text);

const id = process.env.DAORIS_PLUGIN_ID;
const data = process.env.DAORIS_PLUGIN_DATA;
{{helpers}}{{work}}
// The points this plugin listens on, each answering the frame it is sent. A point here that plugin.json
// does not declare is never asked: the handshake answers only the points the manifest names.
const points = {
{{handlers}}
};

// What it implements beside its points (plugin.json's `interfaces`), each asked of a process started for that ask alone, so a
// command keeps between its rounds only what it writes to its storage:
//   command/run  one round of a command it declares, `daoris {{id}} hello` at a terminal: { command, args, answers, from } answered
//                { said: [lines], exit } where it ends, or { said, ask: { name, prompt, masked } } where it asks the person a value
//   view/read    what a view it declares shows: a tree Daoris draws in its own look, { ui: 1, body: [nodes] }
const interfaces = {
  'command/run': async ({ command }) => {
    if (command !== 'hello') return { said: [`${id} has no command ${command}.`], exit: 2 };
    const storage = process.env.DAORIS_PLUGIN_PRIVATE;
    if (!storage) return { said: [`${id}'s storage is switched off, so it keeps nothing.`], exit: 1 };
    const kept = records(`${storage}/state.json`);
    const asked = (kept.get('hello', 'asked') ?? 0) + 1;
    kept.put('hello', 'asked', asked);
    return { said: [`Hello from {{name}}: asked ${asked} time${asked === 1 ? '' : 's'}.`], exit: 0 };
  },
  'view/read': async () => ({
    ui: 1,
    body: [{ kind: 'section', title: '{{name}}', children: [{ kind: 'text', text: 'Say here what this plugin shows.' }] }],
  }),
};

// What it answers: its points, the requests asked beside them that no manifest names, and its interfaces.
const answers = { ...points{{calls}}, ...interfaces };

// One frame answered once its handler settles, never after the frame before it: a slow read holds back no other answer, and
// Daoris waits 10 s for each. A handler that throws is a refusal, which the driver says in this plugin's name. Never silence.
const answer = async (frame) => {
  try {
    send({ jsonrpc: '2.0', id: frame.id, result: await answers[frame.method.slice(5)](frame.params ?? {}) });
  } catch (error) {
    send({ jsonrpc: '2.0', id: frame.id, error: { code: -32603, message: String(error?.message ?? error) } });
  }
};

for await (const line of createInterface({ input: process.stdin })) {
  if (!line.trim()) continue;
  let frame;
  try {
    frame = JSON.parse(line);
  } catch {
    say(`not a frame: ${line}`);
    continue;
  }

  if (frame.method === 'initialize') {
    const declared = frame.params?.points ?? [];
    send({ jsonrpc: '2.0', id: frame.id, result: { protocolVersion: 1, points: Object.keys(points).filter((point) => declared.includes(point)){{capabilities}} } });
  } else if (frame.method === 'shutdown') {
    process.exit(0);
  } else if (typeof frame.method === 'string' && frame.method.startsWith('hook/') && answers[frame.method.slice(5)]) {
    answer(frame);
  } else if (frame.id !== undefined) {
    send({ jsonrpc: '2.0', id: frame.id, error: { code: -32601, message: `no ${frame.method}` } });
  }
}
