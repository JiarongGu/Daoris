{
  "id": "plan-review-apply",
  "order": 10,
  "name": "Plan, review and apply workflow",
  "for": "For a system: one session at a time plans its change, you review the plan, and the plan you accepted is applied; a plan gone stale goes back to the work, which plans again from what the system holds.",
  "setUp": false,
  "graph": {
    "schemaVersion": 2,
    "entries": ["work"],
    "end": "apply",
    "nodes": [
      { "id": "work", "kind": "claimed", "version": 1, "reach": "observed" },
      { "id": "requests", "kind": "work.requests", "version": 1, "reach": "observed" },
      { "id": "review", "kind": "review", "version": 1, "reach": "pressed" },
      { "id": "apply", "kind": "apply", "version": 1, "reach": "performed" }
    ],
    "wires": [
      { "id": "a", "kind": "after", "from": "work", "to": "requests" },
      { "id": "b", "kind": "after", "from": "requests", "to": "review" },
      { "id": "c", "kind": "after", "from": "review", "to": "apply" },
      { "id": "d", "kind": "back", "from": "review", "on": "rejected", "to": "work" },
      { "id": "e", "kind": "back", "from": "apply", "on": "failed", "to": "work" }
    ]
  }
}
