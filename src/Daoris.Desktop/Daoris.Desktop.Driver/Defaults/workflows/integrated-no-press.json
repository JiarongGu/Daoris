    "wires": [
      { "id": "a", "kind": "after", "from": "work", "to": "requests" },
      { "id": "h", "kind": "after", "from": "requests", "to": "holds" },
      { "id": "i", "kind": "after", "from": "holds", "to": "content" },
      { "id": "b", "kind": "after", "from": "content", "to": "landing" },
      { "id": "c", "kind": "after", "from": "landing", "to": "integrate" },
      { "id": "d", "kind": "after", "from": "integrate", "to": "line" }
    ]
