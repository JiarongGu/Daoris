{
  "id": "team-part",
  "order": 11,
  "name": "Team part workflow",
  "for": "For one piece of a planned ask: its work is checked, and once its agent is done its integration request, tagged with the ask and the part, joins the line's one queue and lands on the ask's branch.",
  "setUp": false,
  "graph": {
    "schemaVersion": 2,
    "entries": ["work"],
    "end": "line",
    "nodes": [
      { "id": "work", "kind": "claimed", "version": 1, "reach": "observed" },
      { "id": "requests", "kind": "work.requests", "version": 1, "reach": "observed" },
      { "id": "holds", "kind": "quest.holds", "version": 1, "reach": "observed" },
      { "id": "content", "kind": "content.holds", "version": 1, "reach": "observed" },
      { "id": "check", "kind": "check", "version": 1, "reach": "performed" },
      { "id": "landing", "kind": "land", "version": 1, "reach": "performed", "options": { "method": "integrate" } },
      { "id": "integrate", "kind": "integrate", "version": 1, "reach": "waited", "options": { "request": "done", "conflicts": "session" } },
      { "id": "line", "kind": "line", "version": 1, "reach": "observed" }
    ],
    "wires": [
      { "id": "a", "kind": "after", "from": "work", "to": "requests" },
      { "id": "h", "kind": "after", "from": "requests", "to": "holds" },
      { "id": "i", "kind": "after", "from": "holds", "to": "content" },
      { "id": "b", "kind": "after", "from": "content", "to": "check" },
      { "id": "e", "kind": "after", "from": "check", "to": "landing" },
      { "id": "c", "kind": "after", "from": "landing", "to": "integrate" },
      { "id": "d", "kind": "after", "from": "integrate", "to": "line" }
    ]
  }
}
