{
  "id": "pull-request",
  "order": 5,
  "names": { "en": "A pull request", "zh": "拉取请求" },
  "for": {
    "en": "For a repository on a code host: you review the work, and a plugin pushes its branch and opens a pull request for you to merge.",
    "zh": "适用于托管在代码平台上的仓库：由你审阅工作，插件推送其分支并发起拉取请求，由你合并。"
  },
  "delivery": { "method": "pull-request", "accept": "you" },
  "setUp": true,
  "graph": {
    "schemaVersion": 2,
    "entries": ["work"],
    "end": "pull-request",
    "nodes": [
      { "id": "work", "kind": "claimed", "version": 1, "reach": "observed" },
      { "id": "requests", "kind": "work.requests", "version": 1, "reach": "observed" },
      { "id": "holds", "kind": "quest.holds", "version": 1, "reach": "observed" },
      { "id": "content", "kind": "content.holds", "version": 1, "reach": "observed" },
      { "id": "review", "kind": "review", "version": 1, "reach": "pressed" },
      { "id": "landing", "kind": "land", "version": 1, "reach": "performed", "options": { "method": "pull-request" } },
      { "id": "pushed", "kind": "pushed", "version": 1, "reach": "observed" },
      { "id": "pull-request", "kind": "pull-request", "version": 1, "reach": "observed" }
    ],
    "wires": [
      { "id": "a", "kind": "after", "from": "work", "to": "requests" },
      { "id": "h", "kind": "after", "from": "requests", "to": "holds" },
      { "id": "i", "kind": "after", "from": "holds", "to": "content" },
      { "id": "b", "kind": "after", "from": "content", "to": "review" },
      { "id": "e", "kind": "after", "from": "review", "to": "landing" },
      { "id": "c", "kind": "after", "from": "landing", "to": "pushed" },
      { "id": "d", "kind": "after", "from": "pushed", "to": "pull-request" }
    ]
  }
