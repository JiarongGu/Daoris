{
  "id": "pull-request",
  "order": 5,
  "name": "Hosted merge workflow",
  "for": "For a repository on GitHub: you review the work, Daoris pushes its branch, the GitHub pull request plugin opens a pull request for you to merge, and once it is merged Daoris tidies the work's branches away.",
  "delivery": {
    "name": "A pull request",
    "for": "For a repository on GitHub: you review the work, Daoris pushes its branch, the GitHub pull request plugin opens a pull request for you to merge, and once it is merged Daoris tidies the work's branches away."
  },
  "setUp": true,
  "graph": {
    "schemaVersion": 2,
    "entries": ["work"],
    "end": "tidy",
    "nodes": [
      { "id": "work", "kind": "claimed", "version": 1, "reach": "observed" },
      { "id": "requests", "kind": "work.requests", "version": 1, "reach": "observed" },
      { "id": "holds", "kind": "quest.holds", "version": 1, "reach": "observed" },
      { "id": "content", "kind": "content.holds", "version": 1, "reach": "observed" },
      { "id": "review", "kind": "review", "version": 1, "reach": "pressed" },
      { "id": "landing", "kind": "land", "version": 1, "reach": "performed", "options": { "method": "branch" } },
      { "id": "push", "kind": "push", "version": 1, "reach": "performed" },
      { "id": "pull-request", "kind": "daoris-github/pull-request", "version": 1, "reach": "performed" },
      { "id": "monitor", "kind": "monitor", "version": 1, "reach": "observed", "outcomes": ["merged", "closed"] },
      { "id": "tidy", "kind": "tidy", "version": 1, "reach": "performed" },
      { "id": "closed", "kind": "human", "version": 1, "reach": "pressed" }
    ],
    "wires": [
      { "id": "a", "kind": "after", "from": "work", "to": "requests" },
      { "id": "h", "kind": "after", "from": "requests", "to": "holds" },
      { "id": "i", "kind": "after", "from": "holds", "to": "content" },
      { "id": "b", "kind": "after", "from": "content", "to": "review" },
      { "id": "e", "kind": "after", "from": "review", "to": "landing" },
      { "id": "c", "kind": "after", "from": "landing", "to": "push" },
      { "id": "d", "kind": "after", "from": "push", "to": "pull-request" },
      { "id": "m", "kind": "after", "from": "pull-request", "to": "monitor" },
      { "id": "t", "kind": "when", "from": "monitor", "to": "tidy", "outcome": "merged" },
      { "id": "x", "kind": "when", "from": "monitor", "to": "closed", "outcome": "closed" }
    ]
  }
}
