{
  "id": "pull-request-release",
  "order": 13,
  "name": "Pull request and release workflow",
  "for": "For a repository on Azure DevOps that releases: the work's Accept follows the risk policy (it passes where nothing gates it), Daoris pushes its branch and the Azure DevOps plugin opens a pull request; once it is merged the release manager releases it by its own acts, as the repository's delivery knowledge says, each settled by its receipt, while the approver approves the stage; then the release manager proposes whether a config change is needed and the owner confirms it, the config changer changes the live config where it is, and operations checks the release.",
  "delivery": {
    "name": "A pull request, then its release",
    "for": "For a repository on Azure DevOps that releases: the work's Accept follows the risk policy (it passes where nothing gates it), a plugin pushes its branch and opens a pull request, and once it is merged its release runs as steps of the run, to the config change and the release's check."
  },
  "setUp": false,
