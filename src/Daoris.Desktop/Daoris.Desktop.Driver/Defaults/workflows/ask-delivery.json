{
  "id": "ask-delivery",
  "order": 12,
  "name": "Ask delivery workflow",
  "for": "For a planned ask: it waits until every part of its plan has landed on the ask's branch, the whole is checked together, and you accept it once; then the ask's branch lands on the line.",
  "setUp": false,
  "graph": {
    "schemaVersion": 2,
    "entries": ["parts"],
    "end": "line",
    "nodes": [
      { "id": "parts", "kind": "parts", "version": 1, "reach": "observed" },
      { "id": "check", "kind": "check", "version": 1, "reach": "performed" },
      { "id": "review", "kind": "review", "version": 1, "reach": "pressed" },
      { "id": "landing", "kind": "land", "version": 1, "reach": "performed", "options": { "method": "merge" } },
      { "id": "line", "kind": "line", "version": 1, "reach": "observed" }
    ],
    "wires": [
      { "id": "a", "kind": "after", "from": "parts", "to": "check" },
      { "id": "b", "kind": "after", "from": "check", "to": "review" },
      { "id": "c", "kind": "after", "from": "review", "to": "landing" },
      { "id": "d", "kind": "after", "from": "landing", "to": "line" }
    ]
  }
}
