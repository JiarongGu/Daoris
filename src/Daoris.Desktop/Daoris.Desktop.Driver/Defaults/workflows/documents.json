{
  "id": "documents",
  "order": 3,
  "name": "Documents workflow",
  "for": "For a kind of task whose paths are documents: the work merges into the line once it is done, with no review.",
  "setUp": false,
  "graph": {
    "schemaVersion": 2,
    "entries": ["work"],
    "end": "worktree",
    "nodes": [
      { "id": "work", "kind": "claimed", "version": 1, "reach": "observed" },
      { "id": "holds", "kind": "quest.holds", "version": 1, "reach": "observed" },
      { "id": "content", "kind": "content.holds", "version": 1, "reach": "observed" },
      { "id": "landing", "kind": "land", "version": 1, "reach": "performed", "options": { "method": "merge" } },
      { "id": "line", "kind": "line", "version": 1, "reach": "observed" },
      { "id": "worktree", "kind": "release", "version": 1, "reach": "performed" }
    ],
    "wires": [
      { "id": "a", "kind": "after", "from": "work", "to": "holds" },
      { "id": "h", "kind": "after", "from": "holds", "to": "content" },
      { "id": "b", "kind": "after", "from": "content", "to": "landing" },
      { "id": "c", "kind": "after", "from": "landing", "to": "line" },
      { "id": "r", "kind": "after", "from": "line", "to": "worktree" }
    ]
  }
}
