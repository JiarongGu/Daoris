<Project Sdk="Microsoft.NET.Sdk">

  <!-- The headless door to the driver: what the family rehearsal drives, and what the shell (DRV2d)
       embeds. One driver, two hosts — the same reasoning as the service's two doors. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Daoris.Driver.Host</RootNamespace>
    <!-- The name the rehearsal spawns and a person types — matching daoris-knowledge-http's shape. -->
    <AssemblyName>daoris-driver</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Daoris.Desktop.Driver\Daoris.Desktop.Driver.csproj" />
    <!-- A root: the adapters it composes are chosen here and nowhere in the library. -->
    <ProjectReference Include="..\..\Daoris.Adapters\Daoris.Adapters.Clock\Daoris.Adapters.Clock.csproj" />
    <ProjectReference Include="..\..\Daoris.Adapters\Daoris.Adapters.DesktopStore.Sqlite\Daoris.Adapters.DesktopStore.Sqlite.csproj" />
    <ProjectReference Include="..\..\Daoris.Adapters\Daoris.Adapters.Git\Daoris.Adapters.Git.csproj" />
    <ProjectReference Include="..\..\Daoris.Adapters\Daoris.Adapters.Machine\Daoris.Adapters.Machine.csproj" />
  </ItemGroup>

</Project>
