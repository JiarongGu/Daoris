{
  "name": "daoris",
  "version": "0.0.1",
  "description": "Engineering doctrine for coding agents, kept the same in every repository: write a shared canon of rules, knowledge and skills into AGENTS.md and .claude/, and fail an offline check when a copy drifts.",
  "keywords": [
    "ai-agents",
    "coding-agents",
    "agents-md",
    "claude-code",
    "codex",
    "llm",
    "doctrine",
    "engineering-standards",
    "agent-rules",
    "skills",
    "knowledge-base",
    "drift",
    "cli",
    "monorepo"
  ],
  "homepage": "https://github.com/JiarongGu/Daoris#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JiarongGu/Daoris.git",
    "directory": "src/Daoris.Cli"
  },
  "bugs": {
    "url": "https://github.com/JiarongGu/Daoris/issues"
  },
  "type": "module",
  "bin": {
    "daoris": "bin/daoris.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "dist",
    "canon",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.ts\"",
    "tooltests": "node --test \"tool-test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build && node ../../tools/stage-package.mjs",
    "postpack": "node ../../tools/stage-package.mjs --clean"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
