<Project>

  <!--
    Central package versions for the service tree.

    The cognition sibling is deliberately ABSENT for now. The first slice ingests and classifies
    knowledge, which needs no embeddings, no vector store and no model — and adding the dependency
    before there is a query that needs it would be paying its cost for nothing. It arrives when
    semantic search does (see DECISIONS.md D22).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- The cognition sibling, consumed as a LIBRARY and at a RELEASED version (D22): IEmbedder and
         IVectorStore are the seams semantic search needs, and rebuilding either would be the second
         worse copy D1 was written to prevent. Its serving surfaces are deliberately NOT used. -->
    <PackageVersion Include="Lyntai.Core" Version="2.1.0" />
    <!-- HttpEmbedder: speaks Ollama's native /api/embed and OpenAI-compatible endpoints, batches,
         and needs no key for a local endpoint. Wired only in the host, so the domain stays on the
         abstractions. -->
    <PackageVersion Include="Lyntai.Providers.Default" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions match the cognition sibling's, so the two agree when they end up in one process. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <!-- The DI + stdio hosting extensions. NOT ModelContextProtocol.AspNetCore: the protocol works
         over plain streams, so a framework reference on Microsoft.AspNetCore.App would be bought for
         nothing. The cognition sibling reached the same conclusion for its own MCP host. -->
    <PackageVersion Include="ModelContextProtocol" Version="1.4.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
