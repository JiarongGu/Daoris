<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Daoris.Knowledge.Http</RootNamespace>
    <AssemblyName>daoris-knowledge-http</AssemblyName>
    <!-- Doctrine stays read-only (D31); service-state writes exist and are gated by mode — loopback
         trust in local, minted keys on every route in shared (D47 §7). No cookies, and a shared
         deployment serves no page at all. A browser authenticates nothing, yet a browser on this machine
         is on the loopback, so a write from a page the host does not allow is refused by its origin
         (ORIGIN1, BrowserOrigins.cs): loopback trust is no reason a website's page may press a door. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Daoris.Service.Core/Daoris.Service.Core.csproj" />
    <!-- Host-side composition both hosts share as SOURCE: it builds providers, so it cannot live in
         Core (D22, D24) — and it must not be written twice. -->
    <Compile Include="../Daoris.Service.Shared/HostComposition.cs" Link="HostComposition.cs" />
    <!-- The machine log's framework half (LOG1a): it needs the logging framework, which Core does not carry. -->
    <Compile Include="../Daoris.Service.Shared/MachineLogProvider.cs" Link="MachineLogProvider.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The provider lives in the HOST, never in Core: the domain holds IVectorProvider and nothing
         that implements one, which is what keeps a model out of it (D22, D24). -->
    <PackageReference Include="Lyntai.Providers.Basic" />
  </ItemGroup>
</Project>
