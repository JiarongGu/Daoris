<Project Sdk="Microsoft.NET.Sdk">

  <!-- A stdio MCP server: the surface a session talks to. Chosen before a web UI because an agent
       can call it directly, it is less to build, and it makes the index useful DURING development
       rather than after it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Daoris.Knowledge.Mcp</RootNamespace>
    <AssemblyName>daoris-knowledge</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Daoris.Service.Core\Daoris.Service.Core.csproj" />
    <!-- Lyntai's memory engines, composed here. Private, so the service's unit tests, which reference this host for its tools, reach
         no real engine through it. -->
    <ProjectReference Include="..\..\Daoris.Adapters\Daoris.Adapters.Memory.Lyntai\Daoris.Adapters.Memory.Lyntai.csproj" PrivateAssets="all" />
    <Using Include="Daoris.Ports.Memory" />
    <!-- Host-side composition both hosts share as SOURCE: it builds providers, so it cannot live in
         Core (D22, D24) — and it must not be written twice. -->
    <Compile Include="..\Daoris.Service.Shared\HostComposition.cs" Link="HostComposition.cs" />
    <!-- The machine log's framework half (LOG1a): it needs the logging framework, which Core does not carry. -->
    <Compile Include="..\Daoris.Service.Shared\MachineLogProvider.cs" Link="MachineLogProvider.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lyntai.Providers.Basic" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

</Project>
