# Private, machine-specific, or otherwise never-tracked material.
# `local/` holds absolute paths and private sibling names — it must never enter history.
local/

node_modules/

# Scratch: fixtures, probes, dumps. Never OS temp (see the doctrine's no-tmp rule).
_fixtures/
devtools/_*

# Inherited devtools build output. Scoped to devtools/ on purpose: at the repo
# root, bin/ is this package's CLI entry point, not build output.
devtools/**/bin/
devtools/**/obj/

*.log
.DS_Store

# The canon is staged into the CLI package at pack time (tools/stage-canon.mjs);
# the tracked copy is canon/ at the root.
src/Daoris.Cli/canon/
src/Daoris.Cli/LICENSE
src/Daoris.Cli/README.md
